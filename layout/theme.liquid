<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    <link
      rel="stylesheet"
      href="https://cdn.rawgit.com/mfd/f3d96ec7f0e8f034cc22ea73b3797b59/raw/856f1dbb8d807aabceb80b6d4f94b464df461b3e/gotham.css"
    >
    <link rel="stylesheet" href="{{ 'custom.css' | asset_url }}">
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script
      src="{{ 'critical.js' | asset_url }}"
      type="module"
      async
      blocking="render"
    ></script>
    {% if page.handle == 'faq' %}
      <style>
        rte-formatter h3 {
          font-family: 'Gotham', sans-serif;
          font-weight: 700;
          color: #382d43;
          font-size: 1.9rem;
        }

        .accordion {
          width: 65%;
          gap: 15px;
          display: flex;
          flex-direction: column;
        }

        accordion-custom details[open] .details__header {
          font-size: 1rem !important;
          color: #4b0081 !important;
          font-weight: 400 !important;
          padding: 0;
          z-index: 2;
        }
        accordion-custom details .details__header {
          font-size: 1rem !important;
          color: #211e24 !important;
          font-weight: 400 !important;
          padding: 0;
          z-index: 2;
        }

        .details__header span {
          background: #9e3eb2;
          color: #fff;
          height: 30px;
          width: 30px;
          border-radius: 50%;
        }

        .details-content p {
          font-size: 1rem;
          color: #382d43;
          font-weight: 300;
          margin-top: 15px !important;
          z-index: 2;
        }

        .details {
          position: relative;
          border: 1px solid transparent;
          /* controls border thickness */
          border-radius: 10px;
          background: linear-gradient(#fff, #fff) padding-box,
            /* inner background */ linear-gradient(100deg, #ec68a8, #6c22b7) border-box;
          /* gradient border */
          background-origin: border-box;
          background-clip: padding-box, border-box;
          padding: 13px 20px;
        }

        .section-content-wrapper.section-content-wrapper {
          gap: 20px;
          padding-bottom: 0;
        }
        .section-content-wrapper.section-content-wrapper .button {
          font-family: 'Gotham', sans-serif;
          font-weight: 400;
          font-size: 0.65rem;
          margin-bottom: 60px;
          padding: 20px 90px;
        }
      </style>
    {% endif %}
    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
    <script type="module">
      import { initializeApp } from 'https://www.gstatic.com/firebasejs/11.0.1/firebase-app.js';
      import { getFirestore } from 'https://www.gstatic.com/firebasejs/11.0.1/firebase-firestore.js';

      // Firebase config
      const firebaseConfig = {
        apiKey: 'AIzaSyAp18R6kC6JqdnEFb-hUmEyq0PsKPEJgAY',
        authDomain: 'amino-forge-product-reviews.firebaseapp.com',
        projectId: 'amino-forge-product-reviews',
        storageBucket: 'amino-forge-product-reviews.firebasestorage.app',
        messagingSenderId: '577965437155',
        appId: '1:577965437155:web:9cb889cd942e471f1215d6',
        measurementId: 'G-ESVSTBHCZZ',
      };

      // Initialize globally
      window.firebaseApp = initializeApp(firebaseConfig);
      window.db = getFirestore(window.firebaseApp);
    </script>

    <script type="module">
      import { initializeApp } from 'https://www.gstatic.com/firebasejs/11.0.1/firebase-app.js';
      import {
        getFirestore,
        collection,
        getDocs,
        query,
        where,
      } from 'https://www.gstatic.com/firebasejs/11.0.1/firebase-firestore.js';

      const firebaseConfig = {
        apiKey: 'AIzaSyAp18R6kC6JqdnEFb-hUmEyq0PsKPEJgAY',
        authDomain: 'amino-forge-product-reviews.firebaseapp.com',
        projectId: 'amino-forge-product-reviews',
        storageBucket: 'amino-forge-product-reviews.firebasestorage.app',
        messagingSenderId: '577965437155',
        appId: '1:577965437155:web:9cb889cd942e471f1215d6',
        measurementId: 'G-ESVSTBHCZZ',
      };

      // Init Firebase (once)
      let app;
      if (!window.firebaseApp) {
        try {
          app = initializeApp(firebaseConfig);
          window.firebaseApp = app;
          console.log('[Ratings] Firebase initialized');
        } catch (err) {
          console.error('[Ratings] Firebase init error', err);
        }
      } else {
        app = window.firebaseApp;
        console.log('[Ratings] Firebase already initialized');
      }

      const db = getFirestore(app);
      const starURL = 'https://cdn.shopify.com/s/files/1/0961/3190/7863/files/Vector.svg?v=1762802576';

      // Utility: safe query + rendering for each rating element
      async function renderRatingElement(el) {
        if (!el) return;
        const handle = el.getAttribute('data-product-handle');
        if (!handle) {
          console.warn('[Ratings] missing data-product-handle on element', el);
          return;
        }

        // Ensure children exist (create fallback containers if not)
        if (!el.querySelector('.stars')) {
          const s = document.createElement('div');
          s.className = 'stars';
          el.insertBefore(s, el.firstChild);
        }
        if (!el.querySelector('.rating-value')) {
          const v = document.createElement('span');
          v.className = 'rating-value';
          v.textContent = '0.0';
          el.appendChild(v);
        }
        if (!el.querySelector('.rating-count')) {
          const c = document.createElement('span');
          c.className = 'rating-count';
          c.textContent = '(0)';
          el.appendChild(c);
        }
        if (!el.querySelector('.product-rating-spacer')) {
          const sp = document.createElement('span');
          sp.className = 'product-rating-spacer';
          sp.textContent = '|';
          el.appendChild(sp);
        }

        const starsContainer = el.querySelector('.stars');
        const valueEl = el.querySelector('.rating-value');
        const countEl = el.querySelector('.rating-count');
        const spacer = el.querySelector('.product-rating-spacer');

        // Set default visible state (so theme editor shows them)
        starsContainer.style.display = 'inline-flex';
        valueEl.style.display = 'inline';
        countEl.style.display = 'inline';
        spacer.style.display = 'inline';

        try {
          const q = query(collection(db, 'reviews'), where('product', '==', handle));
          const snapshot = await getDocs(q);

          let total = 0;
          snapshot.forEach((doc) => {
            const data = doc.data();
            // defensive: ensure rating numeric
            const r = Number(data.rating) || 0;
            total += r;
          });

          const count = snapshot.size || 0;
          const avgRaw = count ? total / count : 0;
          const avg = avgRaw ? avgRaw.toFixed(1) : '0.0';

          // Update text values
          valueEl.textContent = avg;
          countEl.textContent = `(${count})`;

          // Render star SVGs (filled vs empty)
          const filled = Math.round(avgRaw);
          let starsHTML = '';
          for (let i = 0; i < 5; i++) {
            const cls = i < filled ? 'filled' : 'empty';
            starsHTML += `<img src="${starURL}" alt="star" class="star-icon ${cls}" />`;
          }
          starsContainer.innerHTML = starsHTML;

          // If no reviews: hide numeric rating but KEEP "Write a review"
          if (count === 0) el.style.display = 'none';

          // Inject spacer if not present
          if (!el.querySelector('.product-rating-spacer')) {
            const spacer = document.createElement('span');
            spacer.className = 'product-rating-spacer';
            spacer.textContent = '|';
            el.appendChild(spacer);
          }

          // Inject “Write a review” link if missing
          if (!el.querySelector('.write-review')) {
            const write = document.createElement('span');
            write.className = 'write-review';
            write.textContent = 'Write a review';
            el.appendChild(write);

            // Add smooth scroll behavior
            write.addEventListener('click', (e) => {
              e.preventDefault();
              const reviewForm = document.querySelector('.review-form');
              if (reviewForm) {
                reviewForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            });
          }
        } catch (err) {
          console.error('[Ratings] error loading reviews for', handle, err);
          // On error, do not hide "Write a review"
          starsContainer.style.display = 'none';
          valueEl.style.display = 'none';
          countEl.style.display = 'none';
          spacer.style.display = 'none';
        }
      }

      // Render all rating elements on page or on section re-load
      async function renderAllRatings() {
        const ratingEls = document.querySelectorAll('.product-rating');
        if (!ratingEls || ratingEls.length === 0) {
          console.log('[Ratings] no .product-rating elements found');
          return;
        }
        for (const el of ratingEls) {
          // call but don't await to render in parallel
          renderRatingElement(el);
        }
      }

      // Events for normal page load and Shopify theme editor dynamic loads
      document.addEventListener('DOMContentLoaded', renderAllRatings);
      document.addEventListener('shopify:section:load', renderAllRatings);
      document.addEventListener('shopify:section:reorder', renderAllRatings);
      document.addEventListener('shopify:block:select', renderAllRatings);
      // also listen for ajaxified content (if your theme uses PJAX)
      document.addEventListener('turbolinks:load', renderAllRatings);
      document.addEventListener('pjax:complete', renderAllRatings);
    </script>
  </body>
</html>
