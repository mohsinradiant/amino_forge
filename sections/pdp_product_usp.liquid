<link rel="stylesheet" href="{{ 'pdp_product_usp.css' | asset_url }}">
<div class="section ">
  <div class="pdp_product_usp_container">
    <img class="pdp_product_usp_left_img" src="{{ section.settings.image | img_url: 'master' }}" alt="">
    <div class="pdp_product_usp_container_right_column">
      <p class="section_caption">{{ section.settings.caption }}</p>
      <h2 class="section_heading">{{ section.settings.heading }}</h2>
      <div class="pdp_product_usp_wrapper">
        {% for block in section.blocks %}
          <div class="pdp_product_usp_item">
            {% if block.settings.svg_icon != blank %}
              <img src="{{ block.settings.svg_icon }}" alt="" class="pdp_product_usp_icon" loading="lazy">
            {% elsif block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url }}" alt="" class="pdp_product_usp_icon" loading="lazy">
            {% endif %}
            <div class="pdp_product_usp_item_content">
              <h3 class="pdp_product_usp_item_heading">{{ block.settings.heading }}</h3>
              <p class="pdp_product_usp_item_caption">{{ block.settings.caption }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PDP Product USP",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Caption" }
  ],
  "blocks": [
    {
      "type": "USP",
      "name": "USP",
      "settings": [
        {
          "type": "url",
          "id": "svg_icon",
          "label": "SVG File URL",
          "info": "Upload SVG in Settings → Files and paste the file URL here"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fallback Icon (optional)"
        },
        { "type": "text", "id": "heading", "label": "USP Heading", "default": "USP Heading" },
        { "type": "text", "id": "caption", "label": "USP Caption", "default": "USP Caption" }
      ]
    }
  ],
  "presets": [{ "name": "PDP Product USP" }]
}
{% endschema %}
