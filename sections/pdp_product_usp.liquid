<link rel="stylesheet" href="{{ 'pdp_product_usp.css' | asset_url }}">

<div class="section">
  <div class="pdp_product_usp_container">
    <img class="pdp_product_usp_left_img" src="{{ section.settings.image | img_url: 'master' }}" alt="">

    <div class="pdp_product_usp_container_right_column">
      <p class="section_caption">{{ section.settings.caption }}</p>
      <h2 class="section_heading">{{ section.settings.heading }}</h2>

      <div class="pdp_product_usp_wrapper">
        {% for block in section.blocks %}
          <div class="pdp_product_usp_item" data-index="{{ forloop.index }}">
            {% assign svg_filename = block.settings.svg_filename %}
            {% capture svg_code %}
              {% include svg_filename %}
            {% endcapture %}
            <div class="pdp_product_usp_icon">
              {{ svg_code }}
            </div>

            <div class="pdp_product_usp_item_content">
              <h3 class="pdp_product_usp_item_heading">{{ block.settings.heading }}</h3>
              <p class="pdp_product_usp_item_caption">{{ block.settings.caption }}</p>
              <div class="pdp_product_usp_loader"></div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('.pdp_product_usp_item');
    let currentIndex = 0;
    const intervalTime = 3000; // 3 seconds per block

    function activateItem(index) {
      items.forEach((i) => i.classList.remove('active'));
      items[index].classList.add('active');
    }

    function autoplay() {
      activateItem(currentIndex);
      currentIndex = (currentIndex + 1) % items.length;
    }

    if (items.length > 0) {
      autoplay(); // start first
      setInterval(autoplay, intervalTime);
    }
  });
</script>

{% schema %}
{
  "name": "PDP Product USP",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Caption" }
  ],
  "blocks": [
    {
      "type": "USP",
      "name": "USP",
      "settings": [
        {
          "type": "text",
          "id": "svg_filename",
          "label": "SVG File Name (without .svg extension)"
        },
        { "type": "text", "id": "heading", "label": "USP Heading", "default": "USP Heading" },
        { "type": "text", "id": "caption", "label": "USP Caption", "default": "USP Caption" }
      ]
    }
  ],
  "presets": [{ "name": "PDP Product USP" }]
}
{% endschema %}
