<div class="home_science_container section">
  <img
    class="background-home_science_container"
    src="https://cdn.shopify.com/s/files/1/0961/3190/7863/files/Rectangle_439.png?v=1760621291"
  >
  <div class="home_science_container_inner">
    <h2 class="section_heading">{{ section.settings.heading_1 }}</h2>
    <h3>{{ section.settings.heading_2 }}</h3>
    <p class="section_subheading">{{ section.settings.subheading }}</p>
    <div class="home_science_container_blocks">
      {% for block in section.blocks %}
        <div class="home_science_container_block">
          <img src="{{ block.settings.image | img_url: 'large' }}">
          <h3>{{ block.settings.caption }}</h3>
          <p>{{ block.settings.caption_2 }}</p>
        </div>
      {% endfor %}
    </div>
    <p class="home_science_cta_1">{{ section.settings.cta_caption_1 }}</p>
    <p class="home_science_cta_2">{{ section.settings.cta_caption_2 }}</p>
    <a href="{{section.settings.cta_url}}" class="home_science_cta_button">{{ section.settings.cta_button }}</a>
  </div>
</div>
{% schema %}
{
  "name": "Home Science",
  "blocks": [
    {
      "type": "block",
      "name": "Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "text",
          "id": "caption_2",
          "label": "Caption 2"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading 1"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading 2"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "cta_caption_1",
      "label": "CTA Caption 1"
    },
    {
      "type": "text",
      "id": "cta_caption_2",
      "label": "CTA Caption 2"
    },
    {
      "type": "text",
      "id": "cta_button",
      "label": "CTA Button Text"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    }
  ],
  "presets": [
    {
      "name": "Home Science"
    }
  ]
}
{% endschema %}
