<div class="home_science_container section">
  <h2>{{ section.settings.heading_1 }}</h2>
  <h3>{{ section.settings.heading_2 }}</h3>
  <p>{{ section.settings.subheading }}</p>
  <div class="home_science_container_blocks">
    {% for block in section.blocks %}
      <div class="home_science_container_block">
        <img src="{{ block.settings.image | img_url: 'large' }}">
        <h3>{{ block.settings.caption }}</h3>
        <p>{{ block.settings.caption_2 }}</p>
      </div>
    {% endfor %}
  </div>
  <p>{{ section.settings.cta_caption_1 }}</p>
  <p>{{ section.settings.cta_caption_2 }}</p>
  <a href="{{section.settings.cta_url}}">{{ section.settings.cta_button }}</a>
</div>
{% schema %}
{
  "name": "Home Science",
  "blocks": [
    {
      "type": "block",
      "name": "Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "text",
          "id": "caption_2",
          "label": "Caption 2"
        }
      ]
    }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Home Science"
    }
  ]
}
{% endschema %}
