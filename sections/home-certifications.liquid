<div class="ai-product-feature__certifications">
  <p class="ai-product-feature__certifications_heading">{{ section.settings.heading }}</p>
  <p class="ai-product-feature__certifications_subheading">{{ section.settings.subheading }}</p>
  <div class="ai-product-feature__certifications-images">
    {% for block in section.blocks %}
      {% if block.type == 'image' and block.settings.image != blank %}
        <img src="{{ block.settings.image | img_url: 'master' }}" alt="Certification">
      {% endif %}
    {% endfor %}
  </div>
</div>
<style>
  .ai-product-feature__certifications {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin: 80px 0;
  }
  .ai-product-feature__certifications_heading {
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: #9e3eb2;
  }
  .ai-product-feature__certifications_subheading {
    font-size: 14px;
    color: #333333;
    margin: 0 0 25px 0;
    width: 40%;
    font-weight: 300;
  }
  .ai-product-feature__certifications-images {
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }
  .ai-product-feature__certifications-images img {
    width: 110px;
    height: auto;
  }
</style>
{% schema %}
{
  "name": "Home Certifications",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CERTIFICATIONS"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "We prioritize your health with rigorous testing for purity, potency, and safety. Every batch is lab-tested to ensure you receive the highest quality supplement."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Certification Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Certifications"
    }
  ]
}
{% endschema %}
