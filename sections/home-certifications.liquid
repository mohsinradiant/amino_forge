<div class="ai-product-feature__certifications">
  <p class="ai-product-feature__certifications_heading">{{ section.settings.heading }}</p>
  <p class="ai-product-feature__certifications_subheading">{{ section.settings.subheading }}</p>
  <div class="ai-product-feature__certifications-images">
    {% for block in section.blocks %}
      {% if block.type == 'image' and block.settings.image != blank %}
        <img src="{{ block.settings.image | img_url: 'master' }}" alt="Certification">
      {% endif %}
    {% endfor %}
  </div>
</div>
<style></style>
{% schema %}
{
  "name": "Home Certifications",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CERTIFICATIONS"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "We prioritize your health with rigorous testing for purity, potency, and safety. Every batch is lab-tested to ensure you receive the highest quality supplement."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Certification Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Certifications"
    }
  ]
}
{% endschema %}
