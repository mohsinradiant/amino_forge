<link rel="stylesheet" href="{{ 'product-about-pdp.css' | asset_url }}">
<div class="section">
  <div class="product-about-container">
    <div class="product-about-container-left">
      <h2 class="section_heading">About Amino Forge AF9</h2>
      <div class="product-about-container-left-bottom">
        {% for block in section.blocks %}
          {% if block.type == 'left_column' %}
            <div class="product-about-left_column-item">
              {% if block.settings.image %}
                <img src="{{ block.settings.image | image_url }}" alt="">
              {% endif %}
              <h3 class="product-about-item-title">{{ block.settings.title }}</h3>
              <p class="product-about-item-text">{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="product-about-container-right">
      <h2 class="section_heading">The Science Inside Every Sachet:</h2>
      <div class="product-about-container-left-bottom">
        <div class="product-about-container-left-bottom-header">
          <p>Ingredient</p>
          <p>Role in the Body</p>
        </div>
        {% for block in section.blocks %}
          {% if block.type == 'right_column' %}
            <div class="product-about-container-left-bottom-row">
              <p class="product-about-container-left-bottom-row-left">{{ block.settings.title }}</p>
              <p class="product-about-container-left-bottom-row-right">{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Product About",
  "settings": [],
  "blocks": [
    {
      "type": "left_column",
      "name": "Left Column Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "right_column",
      "name": "Right Column Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product About"
    }
  ]
}
{% endschema %}
