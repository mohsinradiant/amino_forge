{% comment %}
  GSAP Marquee Text Strip Section

  This section creates a horizontally scrolling text strip with customizable text blocks
  and background/text colors. It uses GSAP for a smooth, performant, and unlimited loop.
{% endcomment %}

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ModifiersPlugin.min.js"></script>

<style>
    /* Basic styling for the marquee section */
    .marquee-wrapper {
      overflow: hidden;
      white-space: nowrap;
      padding: 9px 0;
      margin: 0;
      /* Apply settings from liquid */
      background-color: {{ section.settings.bg_color }};
      color: {{ section.settings.text_color }};
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol';
      font-size: {{ section.settings.font_size }};
    }

    /* Container holding the duplicated tracks - this is the element animated by GSAP */
    .marquee-container {
      display: flex;
      width: fit-content; /* Ensure it's wide enough to hold two tracks side-by-side */
      will-change: transform; /* Performance optimization */
    }

    /* The actual track containing the content (rendered twice) */
    .marquee-track {
      display: flex;
      align-items: center;
      flex-shrink: 0; /* Prevents tracks from shrinking */
    }

    /* Style for each text block item */
    .marquee-item {
  display: flex;
      align-items: center;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0;
      text-transform: uppercase;
      padding: 0 20px 0 0px;
      }
      .bullet-point {
          margin: 0 0  0 20px;
      }
</style>

<div class="marquee-wrapper" data-section-id="{{ section.id }}">
  <div class="marquee-container" data-marquee-container>
    {% comment %} Render the content track twice for seamless looping {% endcomment %}
    {% for i in (1..2) %}
      <div class="marquee-track" data-track-index="{{ i }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'text_item' -%}
            <span class="marquee-item" {{ block.shopify_attributes }}>
              {{ block.settings.text | escape }}
              <p class="bullet-point">•</p>
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (window.ModifiersPlugin) {
      gsap.registerPlugin(ModifiersPlugin);
    }
    const sectionId = "{{ section.id }}";
    const wrapper = document.querySelector(`[data-section-id="${sectionId}"]`);
    if (!wrapper) return;

    const container = wrapper.querySelector('[data-marquee-container]');
    const trackOne = wrapper.querySelector('.marquee-track[data-track-index="1"]');
    if (!container || !trackOne) return;

    const speed = {{ section.settings.speed_pps | default: 50 }}; // pixels per second

    function initMarquee() {
      // Kill any existing tween before re-initializing
      if (container._marqueeTween) {
        container._marqueeTween.kill();
        container._marqueeTween = null;
      }

      // Reset position for fresh measurement and animation
      gsap.set(container, { x: 0 });

      // Measure after layout
      const trackWidth = trackOne.getBoundingClientRect().width;
      if (!trackWidth || trackWidth <= 0) {
        // Try again on next frame if fonts/images/layout aren't ready yet
        requestAnimationFrame(initMarquee);
        return;
      }

      const duration = trackWidth / speed;

      // Seamless loop: wrap x between [-trackWidth, 0)
      const wrapX = gsap.utils.wrap(-trackWidth, 0);
      container._marqueeTween = gsap.to(container, {
        x: -trackWidth,
        duration: duration,
        ease: "none",
        repeat: -1,
        overwrite: true,
        modifiers: {
          x: function(value) {
            const numeric = parseFloat(value) || 0;
            return wrapX(numeric) + "px";
          }
        }
      });
    }

    // Initialize once layout is ready
    requestAnimationFrame(initMarquee);

    // Recompute on resize for responsiveness
    let resizeObserver;
    if (window.ResizeObserver) {
      resizeObserver = new ResizeObserver(() => initMarquee());
      resizeObserver.observe(trackOne);
    } else {
      let resizeTimeout;
      window.addEventListener('resize', function() {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(initMarquee, 150);
      });
    }
  });
</script>

{% schema %}
{
  "name": "GSAP Running Marquee",
  "tag": "section",
  "class": "section-running-marquee",
  "max_blocks": 15,
  "settings": [
    {
      "type": "header",
      "content": "Marquee Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1a533c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "Font Size",
      "default": "1.25rem",
      "options": [
        { "value": "1rem", "label": "Small" },
        { "value": "1.25rem", "label": "Medium" },
        { "value": "1.5rem", "label": "Large" },
        { "value": "1.75rem", "label": "Extra Large" }
      ]
    },
    {
      "type": "range",
      "id": "speed_pps",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "p/s",
      "label": "Scroll Speed (pixels/second)",
      "default": 50,
      "info": "Adjusts the scroll speed of the text strip. Higher value is faster."
    }
  ],
  "blocks": [
    {
      "type": "text_item",
      "name": "Text Block",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Feature Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Seamless Strip"
    }
  ]
}
{% endschema %}
