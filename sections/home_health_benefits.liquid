<div class="home_health_benefits section">
  <div class="home_health_benefits_inner">
    <h2 class="section_heading">{{ section.settings.heading_1 }}</h2>
    <p class="section_subheading">{{ section.settings.subheading }}</p>
    {% comment %} <img src="{{ section.settings.image | img_url: 'master' }}" alt="Health Benefits Image"> {% endcomment %}
    <div class="home_health_benefits-images_container">
      <div class="home_health_benefits-images_column">
        <img
          class="benefit_img"
          src="https://cdn.shopify.com/s/files/1/0961/3190/7863/files/top-left.png?v=1760683120"
          alt="Benefit 1"
        >
        <img
          class="benefit_img"
          src="https://cdn.shopify.com/s/files/1/0961/3190/7863/files/bottom-left.png?v=1760683123"
          alt="Benefit 1"
        >
      </div>
      <div class="home_health_benefits-images_column">
        <img
          class="benefit_img"
          src="https://cdn.shopify.com/s/files/1/0961/3190/7863/files/center.png?v=1760683123"
          alt="Benefit 1"
        >
      </div>
      <div class="home_health_benefits-images_column">
        <img
          class="benefit_img"
          src="https://cdn.shopify.com/s/files/1/0961/3190/7863/files/top-right.png?v=1760683123"
          alt="Benefit 1"
        >
        <img
          class="benefit_img"
          src="https://cdn.shopify.com/s/files/1/0961/3190/7863/files/bottom-right.png?v=1760683122"
          alt="Benefit 1"
        >
      </div>
    </div>
  </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script>
  document.querySelectorAll('.benefit_img').forEach((img) => {
    const hoverIn = () => {
      gsap.to(img, {
        scale: 1.07,
        rotation: 1,
        y: -8,
        duration: 0.5,
        ease: 'power3.out',
        boxShadow: '0 15px 30px rgba(0,0,0,0.2)',
        filter: 'brightness(1.1)',
      });
    };

    const hoverOut = () => {
      gsap.to(img, {
        scale: 1,
        rotation: 0,
        y: 0,
        duration: 0.5,
        ease: 'power3.inOut',
        boxShadow: '0 0 0 rgba(0,0,0,0)',
        filter: 'brightness(1)',
      });
    };

    img.addEventListener('mouseenter', hoverIn);
    img.addEventListener('mouseleave', hoverOut);
  });
</script>
{% schema %}
{
  "name": "Home Health Benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading 1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Home Health Benefits"
    }
  ]
}
{% endschema %}
