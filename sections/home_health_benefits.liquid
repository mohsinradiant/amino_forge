<div class="home_health_benefits section">
  <div class="home_health_benefits_inner">
    <h2 class="section_heading">{{ section.settings.heading_1 }}</h2>
    <p class="section_subheading">{{ section.settings.subheading }}</p>
    <img src="{{ section.settings.image | img_url: 'master' }}" alt="Health Benefits Image">
  </div>
</div>
{% schema %}
{
  "name": "Home Health Benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading 1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Home Health Benefits"
    }
  ]
}
{% endschema %}
