{% comment %}
  GSAP Infinite Testimonials Carousel — precise animation:
  - center testimonial fully visible (image + texts)
  - only prev/next images visible on sides (small + faded)
  - on change: texts fade out completely, then images slide/grow, then new texts fade in
{% endcomment %}

<section class="testimonials-carousel-section">
  <p class="section_caption">{{ section.settings.caption }}</p>
  <h2 class="section_heading">{{ section.settings.heading_1 }}</h2>

  <div class="testimonials-carousel-container">
    <!-- Prev Button -->
    <button class="testimonials-prev-btn" aria-label="Previous">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M15 18l-6-6 6-6"/>
      </svg>
    </button>

    <!-- Profiles Wrapper -->
    <div class="testimonials-profiles" aria-live="polite">
      {% for block in section.blocks %}
        <div class="testimonials-profile-item" data-index="{{ forloop.index0 }}">
          <div class="testimonials-profile-img">
            <img src="{{ block.settings.image | img_url: '300x300' }}" alt="{{ block.settings.name }}">
          </div>

          <!-- content wrapper that will fade in/out (only visible for active) -->
          <div class="testimonials-content">
            <h3 class="testimonials-name">{{ block.settings.name }}</h3>
            <p class="testimonials-role">{{ block.settings.role }}</p>
            <div class="testimonials-stars">★★★★★</div>
            <h4 class="testimonials-title">{{ block.settings.title }}</h4>
            <p class="testimonials-text">{{ block.settings.text }}</p>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Next Button -->
    <button class="testimonials-next-btn" aria-label="Next">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M9 6l6 6-6 6"/>
      </svg>
    </button>
  </div>
  <!-- GSAP -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const items = gsap.utils.toArray('.testimonials-profile-item');
      if (!items.length) return;

      let current = 0;
      let isAnimating = false;
      const leftOffset = -160; // x position for left side image (pixels)
      const rightOffset = 160; // x position for right side image (pixels)
      const sideScale = 0.78; // scale for side images
      const sideOpacity = 0.35; // opacity for side images
      const centerScale = 1; // center image scale
      const centerOpacity = 1;

      // helper: get prev/next indices
      function idxPrev(i) {
        return (i - 1 + items.length) % items.length;
      }
      function idxNext(i) {
        return (i + 1) % items.length;
      }

      // initial setup: place current center, prev left, next right, others hidden off & transparent
      function placeInitial() {
        items.forEach((el, i) => {
          gsap.set(el, { clearProps: 'all' }); // clear previous inline transforms
          const img = el.querySelector('.testimonials-profile-img');

          if (i === current) {
            el.classList.add('is-active');
            // center: at x:0 scale 1, image highlighted border
            gsap.set(el, { x: 0, zIndex: 40 });
            gsap.set(img, { scale: centerScale, opacity: centerOpacity, x: 0 });
            img.style.borderColor = '#be1e28';
            // content visible
            gsap.set(el.querySelector('.testimonials-content'), { autoAlpha: 1 });
          } else if (i === idxPrev(current)) {
            el.classList.remove('is-active');
            gsap.set(el, { x: leftOffset, zIndex: 30 });
            gsap.set(img, { scale: sideScale, opacity: sideOpacity, x: 0 });
            img.style.borderColor = 'transparent';
            gsap.set(el.querySelector('.testimonials-content'), { autoAlpha: 0 });
          } else if (i === idxNext(current)) {
            el.classList.remove('is-active');
            gsap.set(el, { x: rightOffset, zIndex: 30 });
            gsap.set(img, { scale: sideScale, opacity: sideOpacity, x: 0 });
            img.style.borderColor = 'transparent';
            gsap.set(el.querySelector('.testimonials-content'), { autoAlpha: 0 });
          } else {
            // place offscreen and invisible
            el.classList.remove('is-active');
            gsap.set(el, { x: 0, zIndex: 10 });
            gsap.set(img, { scale: sideScale * 0.9, opacity: 0, x: 0 });
            img.style.borderColor = 'transparent';
            gsap.set(el.querySelector('.testimonials-content'), { autoAlpha: 0 });
          }
        });
      }

      // orchestrated transition to targetIndex
      function transitionTo(targetIndex, direction = 1) {
        if (isAnimating || targetIndex === current) return;
        isAnimating = true;

        const prevIndex = idxPrev(current);
        const nextIndex = idxNext(current);

        const currentItem = items[current];
        const targetItem = items[targetIndex];
        const leftItem = items[idxPrev(targetIndex)];
        const rightItem = items[idxNext(targetIndex)];

        const tl = gsap.timeline({
          defaults: { ease: 'power2.out' },
          onComplete: () => {
            current = targetIndex;
            // reset classes and inline transforms then placeInitial to ensure stable state
            items.forEach((i) => i.classList.remove('is-active'));
            items[current].classList.add('is-active');
            placeInitial();
            isAnimating = false;
          },
        });

        // 1) fade out current texts fully (quick)
        tl.to(currentItem.querySelector('.testimonials-content'), { autoAlpha: 0, duration: 0.28 }, 0);

        // 2) move & animate images (slide left/right and scale/opacity)
        // direction = 1 (next): images move left; direction = -1 (prev): images move right
        // We'll animate the set of involved items: current, prev, next, target, and neighbors to keep continuity.

        // For NEXT (direction = 1): move WHOLE ITEMS so image and text stay together.
        if (direction === 1) {
          const currImg = currentItem.querySelector('.testimonials-profile-img');
          const nextItem = items[idxNext(current)];
          const nextImg = nextItem.querySelector('.testimonials-profile-img');
          const nextNextIndex = idxNext(idxNext(current));
          const nextNext = items[nextNextIndex];

          // current item slides to left position
          tl.to(currentItem, { x: leftOffset, zIndex: 30, duration: 0.6 }, 0.12);
          tl.to(currImg, { scale: sideScale, opacity: sideOpacity, duration: 0.6 }, 0.12);

          // next item moves from right to center
          tl.fromTo(nextItem, { x: rightOffset, zIndex: 40 }, { x: 0, zIndex: 40, duration: 0.6 }, 0.12);
          tl.fromTo(
            nextImg,
            { scale: sideScale, opacity: sideOpacity },
            { scale: centerScale, opacity: centerOpacity, duration: 0.6 },
            0.12
          );

          // bring the next-next item into right position
          if (nextNext) {
            const nextNextImg = nextNext.querySelector('.testimonials-profile-img');
            tl.to(nextNext, { x: rightOffset, zIndex: 30, duration: 0.6 }, 0.12);
            tl.to(nextNextImg, { scale: sideScale, opacity: sideOpacity, duration: 0.6 }, 0.12);
          }
        } else {
          // PREV (direction = -1)
          const currImg = currentItem.querySelector('.testimonials-profile-img');
          const prevItem = items[idxPrev(current)];
          const prevImg = prevItem.querySelector('.testimonials-profile-img');
          const prevPrevIndex = idxPrev(idxPrev(current));
          const prevPrev = items[prevPrevIndex];

          // current item slides to right
          tl.to(currentItem, { x: rightOffset, zIndex: 30, duration: 0.6 }, 0.12);
          tl.to(currImg, { scale: sideScale, opacity: sideOpacity, duration: 0.6 }, 0.12);

          // prev item moves from left to center
          tl.fromTo(prevItem, { x: leftOffset, zIndex: 40 }, { x: 0, zIndex: 40, duration: 0.6 }, 0.12);
          tl.fromTo(
            prevImg,
            { scale: sideScale, opacity: sideOpacity },
            { scale: centerScale, opacity: centerOpacity, duration: 0.6 },
            0.12
          );

          // bring the prev-prev item into left position
          if (prevPrev) {
            const prevPrevImg = prevPrev.querySelector('.testimonials-profile-img');
            tl.to(prevPrev, { x: leftOffset, zIndex: 30, duration: 0.6 }, 0.12);
            tl.to(prevPrevImg, { scale: sideScale, opacity: sideOpacity, duration: 0.6 }, 0.12);
          }
        }
        // 3) after images moved, fade in the new active content
        tl.to(targetItem.querySelector('.testimonials-content'), { autoAlpha: 1, duration: 0.36 }, '+=0.04');

        // small safety: ensure borders updated
        tl.call(
          () => {
            items.forEach((el, i) => {
              const img = el.querySelector('.testimonials-profile-img');
              img.style.borderColor = i === targetIndex ? '#be1e28' : 'transparent';
            });
          },
          null,
          '-=0.02'
        );
      }

      // next / prev handlers
      function goNext() {
        if (isAnimating) return;
        const nextIndex = idxNext(current);
        transitionTo(nextIndex, 1);
      }
      function goPrev() {
        if (isAnimating) return;
        const prevIndex = idxPrev(current);
        transitionTo(prevIndex, -1);
      }

      // attach controls
      const btnNext = document.querySelector('.testimonials-next-btn');
      const btnPrev = document.querySelector('.testimonials-prev-btn');
      btnNext &&
        btnNext.addEventListener('click', () => {
          goNext();
        });
      btnPrev &&
        btnPrev.addEventListener('click', () => {
          goPrev();
        });

      // autoplay (pauses on hover)
      let autoplayId = null;
      function startAutoplay() {
        autoplayId = setInterval(goNext, 6000);
      }
      function stopAutoplay() {
        if (autoplayId) {
          clearInterval(autoplayId);
          autoplayId = null;
        }
      }

      const wrapper = document.querySelector('.testimonials-profiles');
      wrapper.addEventListener('mouseenter', stopAutoplay);
      wrapper.addEventListener('mouseleave', startAutoplay);

      // initialize
      placeInitial();
      startAutoplay();
    });
  </script>
</section>

{% schema %}
{
  "name": "Home Testimonials",
  "settings": [
    { "type": "text", "id": "caption", "label": "Caption" },
    { "type": "text", "id": "heading_1", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Profile Image" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role & Location" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Testimonial Text" }
      ]
    }
  ],
  "presets": [{ "name": "Home Testimonials" }]
}
{% endschema %}
