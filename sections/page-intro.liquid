<div
  class="page-intro-container"
  style="background-image: url('{{ section.settings.desktop_image | image_url: width: 1600 }}');"
>
  <p>{{ section.settings.caption }}</p>
  <h2>{{ section.settings.heading }}</h2>
</div>

<style>
  @media (max-width: 768px) {
    .page-intro-container {
      background-image: url('{{ section.settings.mobile_image | image_url: width: 768 }}') !important;
    }
  }

  .page-intro-container {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    aspect-ratio: 1920 / 590;
    gap: 10px;
  }
  .page-intro-container p {
    font-size: 1rem;
    font-weight: 900;
    margin: 0;
  }
  .page-intro-container h2 {
    font-family: Gotham, sans-serif !important;
    margin: 0;
    color: #9e3eb2;
    font-size: 3rem;
    font-weight: 900;
    text-transform: uppercase;
  }
</style>

{% schema %}
{
  "name": "Page Intro",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Caption" },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop Image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile Image" }
  ],
  "presets": [
    {
      "name": "Page Intro"
    }
  ]
}
{% endschema %}
