<div class="section home_ingredients_desc">
  <div class="home_ingredients_desc_top_container">
    <div class="home_ingredients_desc_top_container_left">
      <p></p>
      <h2></h2>
    </div>
    <div class="home_ingredients_desc_top_container_right">
      <p></p>
    </div>
  </div>
  <div class="home_ingredients_desc_bottom_container">
    {% for block in section.blocks %}
      <img src="{{ block.settings.image | img_url }}">
    {% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "Home Ingredients Desc",
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Home Ingredients Desc"
    }
  ]
}
{% endschema %}
