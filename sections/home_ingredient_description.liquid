<div class="section home_ingredients_desc">
  <div class="home_ingredients_desc_top_container">
    <div class="home_ingredients_desc_top_container_left">
      <p>{{ section.settings.left_subheading }}</p>
      <h2>{{ section.settings.left_heading }}</h2>
    </div>
    <div class="home_ingredients_desc_top_container_right">
      <p>{{ section.settings.right_content }}</p>
    </div>
  </div>
  <div class="home_ingredients_desc_bottom_container">
    {% for block in section.blocks %}
      <img class="ingredient_img" src="{{ block.settings.image | img_url: 'large' }}">
    {% endfor %}
  </div>
</div>
<!-- GSAP Animation -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script>
  document.querySelectorAll('.ingredient_img').forEach((img) => {
    const hoverIn = () => {
      gsap.to(img, {
        scale: 1.05,
        rotation: 1,
        y: -5,
        duration: 0.5,
        ease: 'power3.out',
        boxShadow: '0 15px 30px rgba(0,0,0,0.2)',
        overwrite: 'auto',
      });
    };

    const hoverOut = () => {
      gsap.to(img, {
        scale: 1,
        rotation: 0,
        y: 0,
        duration: 0.5,
        ease: 'power3.inOut',
        boxShadow: '0 0 0 rgba(0,0,0,0)',
        filter: 'brightness(1)',
        overwrite: 'auto',
      });
    };

    img.addEventListener('mouseenter', hoverIn);
    img.addEventListener('mouseleave', hoverOut);
  });
</script>
{% schema %}
{
  "name": "Home Ingredients Desc",
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "left_subheading",
      "label": "Left Subheading"
    },
    {
      "type": "text",
      "id": "left_heading",
      "label": "Left Heading"
    },
    {
      "type": "text",
      "id": "right_content",
      "label": "Right Content"
    }
  ],
  "presets": [
    {
      "name": "Home Ingredients Desc"
    }
  ]
}
{% endschema %}
