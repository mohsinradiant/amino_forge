<div class="our-story-results-container">
  <div class="section"></div>
</div>
{% schema %}
{
  "name": "Our Story Results",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Fuelling the Future of Cellular Nutrition"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "image_picker",
      "id": "right_bottom_img",
      "label": "Right Bottom Image"
    }
  ],
  "blocks": [
    {
      "type": "founder",
      "name": "Founder",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Founder Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Founder Name",
          "default": "John Doe"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Founder Title",
          "default": "Co-Founder & CEO"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Story Results"
    }
  ]
}
{% endschema %}
