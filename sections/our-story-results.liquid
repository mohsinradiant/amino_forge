<div class="our-story-results-container">
  <div class="section">
    <h2>{{ section.settings.heading }}</h2>
    <div class="our-story-results-content">
      {{ section.settings.content }}
    </div>

    <div class="our-story-results-container-inner">
      {% if section.settings.inner_heading != blank %}
        <p class="our-story-results-container-inner-heading">{{ section.settings.inner_heading }}</p>
      {% endif %}

      <div class="our-story-results-items">
        {% for block in section.blocks %}
          <div class="our-story-results-item">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: 'master' }}" alt="Result Image">
            {% endif %}
            {% if block.settings.content != blank %}
              <p>{{ block.settings.content }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
<style>
  .our-story-results-container {
    background-image: url(https://cdn.shopify.com/s/files/1/0961/3190/7863/files/Rectangle_501.png?v=1761563683);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
</style>
{% schema %}
{
  "name": "Our Story Results",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Our Results Speak for Themselves"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Intro Content",
      "default": "<p>We’ve transformed countless fitness journeys through Amino Forge’s unique formulation and dedication to performance.</p>"
    },
    {
      "type": "text",
      "id": "inner_heading",
      "label": "Inner Section Heading",
      "default": "Results with Amino Forge"
    }
  ],
  "blocks": [
    {
      "type": "result",
      "name": "Result Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Result Image"
        },
        {
          "type": "text",
          "id": "content",
          "label": "Result Text",
          "default": "Visible results in just 4 weeks of consistent use."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Story Results"
    }
  ]
}
{% endschema %}
