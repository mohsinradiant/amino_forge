<div class="our-story-results-container">
  <div class="section">
    <h2>{{ section.settings.heading }}</h2>
    <div class="our-story-results-content">
      {{ section.settings.content }}
    </div>

    <div class="our-story-results-container-inner">
      {% if section.settings.inner_heading != blank %}
        <p class="our-story-results-container-inner-heading">{{ section.settings.inner_heading }}</p>
      {% endif %}

      <div class="our-story-results-items">
        {% for block in section.blocks %}
          <div class="our-story-results-item">
            <p>{{ forloop.index }}</p>
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: 'master' }}" alt="Result Image">
            {% endif %}
            {% if block.settings.content != blank %}
              <p>{{ block.settings.content }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <div class="our-story-results-cta-cutout">
        <div class="our-story-results-cta-cutout-left">
          <p>NEED MORE INFORMATION?</p>
          <p>Talk to Our Nutrition Expert</p>
        </div>
        <a href="{{ section.settings.url }}">ASK A QUESTION</a>
      </div>
    </div>
  </div>
</div>
<style>
  .our-story-results-container {
    background-image: url(https://cdn.shopify.com/s/files/1/0961/3190/7863/files/Rectangle_501.png?v=1761563683);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 100px 0;
  }
  .our-story-results-container h2 {
    font-size: 2.2rem;
    color: #211e24;
    font-family: 'Gotham', sans-serif;
    font-weight: 700;
    margin: 0 0 10px 0;
  }
  .our-story-results-content {
    font-family: 'Gotham', sans-serif;
    font-size: 0.9rem;
    font-weight: 300;
    letter-spacing: 0.2px;
    line-height: 1.9;
    color: #222222;
    margin: 0;
  }
  .our-story-results-container-inner {
    background: white;
    border-radius: 20px;
    padding: 50px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: start;
    gap: 15px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.07);
    margin-top: 50px;
    position: relative;
  }
  .our-story-results-items {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(3, auto);
    column-gap: 40px;
    row-gap: 40px;
  }
  .our-story-results-item {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 25px;
    width: 90%;
    position: relative;
    padding-left: 50px;
  }
  .our-story-results-item img {
    width: 80px;
    height: auto;
  }
  .our-story-results-container-inner-heading {
    font-size: 1.5rem;
    color: #211e24;
    font-family: 'Gotham', sans-serif;
    font-weight: 500;
    margin: 0 0 10px 0;
  }
  .our-story-results-item p:first-of-type {
    font-size: 3rem;
    margin: 0;
    line-height: 0;
    font-weight: 700;
    color: #111111;
    opacity: 0.05;
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
  }
  .our-story-results-item p:last-of-type {
    margin: 0;
    font-weight: 300;
    font-size: 0.9rem;
    color: #444444;
  }
  .our-story-results-cta-cutout {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 48%;
    background: #f7f0f9;
    padding: 30px;
    border-radius: 50px 0 20px 0;
  }
  .our-story-results-cta-cutout p:first-of-type {
    color: #9e3eb2;
    margin: 0;
    font-size: 0.9rem;
  }
  .our-story-results-cta-cutout p:last-of-type {
    color: #333333;
    margin: 0;
    font-size: 1rem;
  }
</style>
{% schema %}
{
  "name": "Our Story Results",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Our Results Speak for Themselves"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Intro Content",
      "default": "<p>We’ve transformed countless fitness journeys through Amino Forge’s unique formulation and dedication to performance.</p>"
    },
    {
      "type": "text",
      "id": "inner_heading",
      "label": "Inner Section Heading",
      "default": "Results with Amino Forge"
    },
    {
      "type": "url",
      "id": "url",
      "label": "CTA URL"
    }
  ],
  "blocks": [
    {
      "type": "result",
      "name": "Result Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Result Image"
        },
        {
          "type": "text",
          "id": "content",
          "label": "Result Text",
          "default": "Visible results in just 4 weeks of consistent use."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Story Results"
    }
  ]
}
{% endschema %}
