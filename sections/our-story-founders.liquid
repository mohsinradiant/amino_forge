<div class="section">
  <div class="our-story-founders-container">
    <div class="our-story-founders-container-left">
      <h2>{{ section.settings.heading }}</h2>
      <div class="our-story-founders-content">
        {{ section.settings.content }}
      </div>
    </div>

    <div class="our-story-founders-container-right">
      <div class="our-story-founders-container-right-top">
        {% for block in section.blocks %}
          <div class="our-story-founders-container-right-top-founder-container">
            <div class="our-story-founders-container-right-top-founder">
              {% if block.settings.image %}
                <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.heading }}">
              {% endif %}
              <div class="">
                <h4>{{ block.settings.heading }}</h4>
                <p>{{ block.settings.subheading }}</p>
              </div>
            </div>
            <p>
              Amino Forge is the brainchild of Ashim Matthan and Dr. Kanishka Jain born from a simple question — Why
              aren’t amino acids absorbed efficiently, even when we consume the best supplements?
            </p>
          </div>
        {% endfor %}
      </div>

      {% comment %}
        {% if section.settings.right_bottom_img != blank %}
          <img
            class="our-story-founders-container-right-bottom-img"
            src="{{ section.settings.right_bottom_img | img_url: 'master' }}"
            alt="Founders bottom image"
          >
        {% endif %}
      {% endcomment %}
    </div>
  </div>
</div>
<style>
  .our-story-founders-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 100px auto;
  }
  .our-story-founders-container-left {
    display: flex;
    justify-content: start;
    align-items: start;
    width: 48%;
    gap: 25px;
    flex-direction: column;
  }
  .our-story-founders-container-left h2 {
    font-size: 2.2rem;
    color: #211e24;
    font-family: 'Gotham', sans-serif;
    font-weight: 700;
    width: 70%;
    margin: 0;
  }
  .our-story-founders-container-left p {
    font-family: 'Gotham', sans-serif;
    font-size: 0.9rem;
    font-weight: 300;
    letter-spacing: 0.2px;
    line-height: 1.9;
    color: #222222;
    margin: 0;
  }
  .our-story-founders-container-right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 40%;
    gap: 55px;
  }
  .our-story-founders-container-right-top {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: start;
    width: 100%;
    gap: 40px;
  }
  .our-story-founders-container-right-top-founder-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: start;
    gap: 10px;
  }
  .our-story-founders-container-right-top-founder-container p {
    margin: 0;
    font-family: 'Gotham', sans-serif;
  }
  .our-story-founders-container-right-top-founder {
    width: 100%;
    display: flex;
    justify-content: start;
    align-items: center;
    gap: 20px;
  }
  .our-story-founders-container-right-top-founder img {
    width: 27%;
  }
  .our-story-founders-container-right-top-founder h4 {
    display: flex;
    text-align: center;
    font-family: 'Gotham', sans-serif;
    font-weight: 500;
    font-size: 0.9rem;
    color: #222222;
    margin-bottom: 3px;
    padding-top: 15px;
  }
  .our-story-founders-container-right-top-founder p {
    text-align: center;
    font-weight: 300;
    color: #555555;
    font-size: 0.8rem;
    margin: 0;
  }
</style>
{% schema %}
{
  "name": "Our Story Founders",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Fuelling the Future of Cellular Nutrition"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "image_picker",
      "id": "right_bottom_img",
      "label": "Right Bottom Image"
    }
  ],
  "blocks": [
    {
      "type": "founder",
      "name": "Founder",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Founder Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Founder Name",
          "default": "John Doe"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Founder Title",
          "default": "Co-Founder & CEO"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Story Founders"
    }
  ]
}
{% endschema %}
