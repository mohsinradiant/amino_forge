{% comment %}
  Vertical Video Carousel Section (Flickity-powered)
{% endcomment %}

<!-- Flickity Library -->
<link rel="stylesheet" href="https://unpkg.com/flickity@2/dist/flickity.min.css">
<script src="https://unpkg.com/flickity@2/dist/flickity.pkgd.min.js"></script>

<style>
  /* Section Layout */
  .vertical-video-section {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
    background-color: {{ section.settings.bg_color }};
  }

  /* Carousel Container */
  .video-carousel {
    max-width: {{ section.settings.section_width }}px;
    margin: 0 auto;
    cursor: grab;
    user-select: none;
    padding: 0 20px;
  }

  /* Each Video Cell */
  .carousel-cell {
    width: {{ section.settings.video_width }}%;
    height: 80vh; /* fixed height so videos show up */
    border-radius: 12px;
    overflow: hidden;
    background-color: #000;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .carousel-cell video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
  }

  /* Overlay Controls */
  .video-controls-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
  }

  .play-pause-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(5px);
    border: none;
    color: white;
    font-size: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease-out;
    pointer-events: none;
    z-index: 20;
  }
  .is-paused .play-pause-btn {
    opacity: 1;
    pointer-events: auto;
  }
  .carousel-cell:hover .play-pause-btn {
    opacity: 0.8;
  }

  .volume-btn {
    align-self: flex-end;
    background: none;
    border: none;
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
    z-index: 20;
  }

  /* Flickity Controls */
  .flickity-prev-next-button {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6) !important;
  }
  .flickity-button-icon {
    fill: white;
  }
</style>

<section class="vertical-video-section" data-section-id="{{ section.id }}">
  <div
    class="video-carousel"
    data-flickity='
      {
        "cellAlign": "left",
        "contain": true,
        "pageDots": false,
        "prevNextButtons": true,
        "wrapAround": false
      }
    '
  >
    {% for block in section.blocks %}
      {% if block.type == 'video' and block.settings.video_file != blank %}
        {% assign video_src = block.settings.video_file | file_url %}
        <div
          class="carousel-cell"
          data-video-cell
          data-media-id="{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          <video
            data-video-player
            src="{{ video_src }}"
            poster="{% if block.settings.video_poster != blank %}{{ block.settings.video_poster | image_url: width: 720 }}{% endif %}"
            loop
            muted
            playsinline
            autoplay
            preload="metadata"
          ></video>

          <div class="video-controls-overlay">
            <button class="volume-btn" data-volume-toggle title="Toggle Volume">
              <span data-icon-muted>🔈</span>
              <span data-icon-unmuted style="display: none;">🔊</span>
            </button>
          </div>

          <button class="play-pause-btn" data-play-pause-toggle title="Play/Pause">
            <span data-icon-play>▶</span>
            <span data-icon-pause style="display: none;">⏸</span>
          </button>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<script>
  window.addEventListener('load', () => {
    const section = document.querySelector(`[data-section-id="{{ section.id }}"]`);
    if (!section) return;

    const carousel = section.querySelector('.video-carousel');
    const flkty = new Flickity(carousel, {
      cellAlign: 'left',
      contain: true,
      pageDots: false,
      prevNextButtons: true,
      wrapAround: false,
    });

    const videoCells = section.querySelectorAll('.carousel-cell');

    const togglePlayPause = (cell, video, btn) => {
      if (video.paused) {
        video.play().catch((err) => console.log('Video play error:', err));
        cell.classList.remove('is-paused');
        btn.querySelector('[data-icon-play]').style.display = 'none';
        btn.querySelector('[data-icon-pause]').style.display = 'block';
      } else {
        video.pause();
        cell.classList.add('is-paused');
        btn.querySelector('[data-icon-play]').style.display = 'block';
        btn.querySelector('[data-icon-pause]').style.display = 'none';
      }
    };

    const toggleVolume = (video, btn) => {
      video.muted = !video.muted;
      btn.querySelector('[data-icon-muted]').style.display = video.muted ? 'inline' : 'none';
      btn.querySelector('[data-icon-unmuted]').style.display = video.muted ? 'none' : 'inline';
    };

    const handleCellChange = (index) => {
      videoCells.forEach((cell, i) => {
        const video = cell.querySelector('[data-video-player]');
        const playPauseBtn = cell.querySelector('[data-play-pause-toggle]');
        if (i === index) {
          video.currentTime = 0;
          video.play().catch((err) => console.log('Autoplay error:', err));
          cell.classList.remove('is-paused');
          playPauseBtn.querySelector('[data-icon-play]').style.display = 'none';
          playPauseBtn.querySelector('[data-icon-pause]').style.display = 'block';
        } else {
          video.pause();
          cell.classList.add('is-paused');
          playPauseBtn.querySelector('[data-icon-play]').style.display = 'block';
          playPauseBtn.querySelector('[data-icon-pause]').style.display = 'none';
        }
      });
    };

    // Set up event listeners
    videoCells.forEach((cell) => {
      const video = cell.querySelector('[data-video-player]');
      const playPauseBtn = cell.querySelector('[data-play-pause-toggle]');
      const volumeBtn = cell.querySelector('[data-volume-toggle]');

      cell.classList.add('is-paused');
      video.muted = true;

      cell.addEventListener('click', (e) => {
        if (e.target.closest('[data-volume-toggle]')) return;
        togglePlayPause(cell, video, playPauseBtn);
      });

      volumeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleVolume(video, volumeBtn);
      });
    });

    flkty.on('change', handleCellChange);
    flkty.on('ready', () => handleCellChange(0));
  });
</script>

{% schema %}
{
  "name": "Vertical Video Carousel",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f5f5"
    },
    {
      "type": "range",
      "id": "section_width",
      "min": 800,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Maximum Carousel Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "video_width",
      "min": 25,
      "max": 40,
      "step": 1,
      "unit": "%",
      "label": "Video Width (Relative)",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Vertical Video",
      "settings": [
        {
          "type": "video",
          "id": "video_file",
          "label": "Video file (from Files)"
        },
        {
          "type": "image_picker",
          "id": "video_poster",
          "label": "Poster Image (Fallback)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vertical Video Stories"
    }
  ]
}
{% endschema %}
