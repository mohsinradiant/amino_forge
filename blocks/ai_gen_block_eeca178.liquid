                  }

                  .ai-product-feature__quantity-label-{{ ai_gen_id }} {
      font-size: 11px;
          color: #222222;
          text-transform: uppercase;
          letter-spacing: 0.5px;
          text-align: left;
          width: 100%;
                  }

                  .ai-product-feature__quantity-selector-{{ ai_gen_id }} {
                    display: flex;
                    align-items: center;
                    border: 1px solid {{ block.settings.text_color }};
        border-radius: 70px;
        overflow: hidden;              }

                  .ai-product-feature__quantity-button-{{ ai_gen_id }} {
      border: none;
      width: 40px;
      height: 40px;
      display: flex
  ;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: #000000;
      font-size: 18px;
      transition: background-color 0.2s;
      background: #F8F8F8;                }

                  .ai-product-feature__quantity-button-{{ ai_gen_id }}:hover {
