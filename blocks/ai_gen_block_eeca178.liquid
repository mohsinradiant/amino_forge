{% doc %}
  @prompt
    Generate a three-column product feature section designed to showcase a single featured product, built to dynamically pull content from the product's data and section settings.
    
    Layout & Dynamic Content Mapping:
    Left Column (Benefits/Icons): Design as a section setting block where the content (e.g., '5x better uptake,' 'Train harder') and corresponding icon/color can be manually input by the user. Visually, present this as a vertical, attention-grabbing list of four key benefits next to simple, distinct icons.
    
    Center Column (Media): This column must be assigned to display the Featured Image of the linked Shopify product.
    
    Right Column (Product Details & CTA): Dynamically pull the Product Title, Product Description, Compare-at-Price, and Selling Price from the linked Shopify product. The pricing must also include a calculated percentage off badge next to the sale price.
    
    Custom Field: Include a line for the weight/serving size which is designed to pull from a dedicated product metafield (e.g., product.metafields.custom.weight).
    
    Action Elements: End this column with a Quantity Selector and the Add to Cart/Shop Now button.
    
    Header & Styling:
    Overall Header: "Amino Forge's AF 9" (This can be a section setting title).
    
    Aesthetic: Use a clean, three-column layout with a minimalist, high-end feel. The primary focus should be on the product image, with the benefits and purchase details clearly separated."
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-feature-{{ ai_gen_id }} {
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-feature__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-product-feature__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-product-feature__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    font-weight: 400;
  }

  .ai-product-feature__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1.5fr 1fr;
    gap: 60px;
    align-items: center;
  }

   .ai-product-feature__benefits-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-left: 88px; /* space for the rail + icons */
  }

  .ai-product-feature__benefits-rail-{{ ai_gen_id }} {
    position: absolute;
    left: 16px;
    top: 0;
    bottom: 0;
    width: 56px;
    border-radius: 9999px;
    background: linear-gradient(180deg, {{ block.settings.benefits_rail_bg_start }} 0%, {{ block.settings.benefits_rail_bg_end }} 100%);
    pointer-events: none;
  }

  .ai-product-feature__benefit-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 56px; /* ensures even spacing over the rail */
  }

  .ai-product-feature__benefit-media-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-feature__benefit-media-{{ ai_gen_id }} img {
    width: 40px;
    height: 40px;
    object-fit: contain;
    display: block;
  }

  .ai-product-feature__benefit-text-{{ ai_gen_id }} {
    font-size: 18px;
    color: {{ block.settings.text_color }};
    font-weight: 500;
    line-height: 1.4;
  }
  .ai-product-feature__media-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .ai-product-feature__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-feature__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-product-feature__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-product-feature__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-product-feature__details-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-product-feature__product-title-{{ ai_gen_id }} {
    font-size: 32px;
    color: {{ block.settings.text_color }};
    margin: 0;
    font-weight: 400;
    line-height: 1.2;
  }

  .ai-product-feature__product-description-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    opacity: 0.8;
  }

  .ai-product-feature__weight-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-product-feature__pricing-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ai-product-feature__price-{{ ai_gen_id }} {
    font-size: 28px;
    color: {{ block.settings.text_color }};
    font-weight: 600;
  }

  .ai-product-feature__compare-price-{{ ai_gen_id }} {
    font-size: 20px;
    color: {{ block.settings.text_color }};
    opacity: 0.5;
    text-decoration: line-through;
  }

  .ai-product-feature__discount-badge-{{ ai_gen_id }} {
    background-color: {{ block.settings.badge_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-product-feature__actions-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 12px;
  }

  .ai-product-feature__quantity-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-product-feature__quantity-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-product-feature__quantity-selector-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    border: 1px solid {{ block.settings.text_color }};
    border-radius: 0;
  }

  .ai-product-feature__quantity-button-{{ ai_gen_id }} {
    background: none;
    border: none;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: {{ block.settings.text_color }};
    font-size: 18px;
    transition: background-color 0.2s;
  }

  .ai-product-feature__quantity-button-{{ ai_gen_id }}:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  .ai-product-feature__quantity-input-{{ ai_gen_id }} {
    width: 50px;
    height: 40px;
    border: none;
    border-left: 1px solid {{ block.settings.text_color }};
    border-right: 1px solid {{ block.settings.text_color }};
    text-align: center;
    font-size: 16px;
    background: transparent;
    color: {{ block.settings.text_color }};
  }

  .ai-product-feature__add-to-cart-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    padding: 16px 32px;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: background-color 0.3s;
    font-weight: 600;
    border-radius: 0;
  }

  .ai-product-feature__add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-product-feature__add-to-cart-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-product-feature__empty-product-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #999;
    font-style: italic;
  }

  @media screen and (max-width: 1024px) {
    .ai-product-feature__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-product-feature__benefits-{{ ai_gen_id }} {
      order: 2;
    }

    .ai-product-feature__media-{{ ai_gen_id }} {
      order: 1;
    }

    .ai-product-feature__details-{{ ai_gen_id }} {
      order: 3;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-feature-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-product-feature__header-{{ ai_gen_id }} {
      margin-bottom: 40px;
    }

    .ai-product-feature__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-product-feature__product-title-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-product-feature__price-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-product-feature__compare-price-{{ ai_gen_id }} {
      font-size: 18px;
    }
  }
{% endstyle %}

<product-feature-{{ ai_gen_id }}
  class="ai-product-feature-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-feature__container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank %}
      <div class="ai-product-feature__header-{{ ai_gen_id }}">
        <h2 class="section_heading">{{ block.settings.section_title }}</h2>
        <p class="section_subheading">{{ block.settings.section_subtitle }}</p>
      </div>
    {% endif %}

    {% if block.settings.product != blank %}
      {% assign product = block.settings.product %}
      {% assign selected_variant = product.selected_or_first_available_variant %}

      <div class="ai-product-feature__grid-{{ ai_gen_id }}">
        <div class="ai-product-feature__benefits-{{ ai_gen_id }}">
          <div class="ai-product-feature__benefits-rail-{{ ai_gen_id }}"></div>
          {% for i in (1..4) %}
            {% liquid
              assign benefit_text_key = 'benefit_' | append: i | append: '_text'
              assign benefit_image_key = 'benefit_' | append: i | append: '_image'

              assign benefit_text = block.settings[benefit_text_key]
              assign benefit_image = block.settings[benefit_image_key]
            %}

            {% if benefit_text != blank %}
              <div class="ai-product-feature__benefit-item-{{ ai_gen_id }}">
                <div class="ai-product-feature__benefit-media-{{ ai_gen_id }}">
                  {% if benefit_image != blank %}
                    <img
                      src="{{ benefit_image | image_url: width: 96 }}"
                      alt="{{ benefit_text | escape }}"
                      loading="lazy"
                      width="{{ benefit_image.width }}"
                      height="{{ benefit_image.height }}"
                    >
                  {% endif %}
                </div>
                <div class="ai-product-feature__benefit-text-{{ ai_gen_id }}">{{ benefit_text }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
    {% else %}
      <div class="ai-product-feature__empty-product-{{ ai_gen_id }}">Next, select a product to feature</div>
    {% endif %}
  </div>
</product-feature-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductFeature{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.quantityInput = this.querySelector('.ai-product-feature__quantity-input-{{ ai_gen_id }}');
        this.quantityButtons = this.querySelectorAll('.ai-product-feature__quantity-button-{{ ai_gen_id }}');
        this.addToCartButton = this.querySelector('.ai-product-feature__add-to-cart-{{ ai_gen_id }}');

        this.setupQuantityControls();
        this.setupAddToCart();
      }

      setupQuantityControls() {
        if (!this.quantityInput || !this.quantityButtons.length) return;

        this.quantityButtons.forEach(button => {
          button.addEventListener('click', () => {
            const action = button.getAttribute('data-action');
            let currentValue = parseInt(this.quantityInput.value) || 1;

            if (action === 'increase') {
              currentValue += 1;
            } else if (action === 'decrease' && currentValue > 1) {
              currentValue -= 1;
            }

            this.quantityInput.value = currentValue;
          });
        });
      }

      setupAddToCart() {
        if (!this.addToCartButton) return;

        this.addToCartButton.addEventListener('click', () => {
          const variantId = this.addToCartButton.getAttribute('data-variant-id');
          const quantity = parseInt(this.quantityInput.value) || 1;

          if (!variantId) return;

          this.addToCartButton.disabled = true;
          this.addToCartButton.textContent = 'Adding...';

          fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: variantId,
              quantity: quantity
            })
          })
          .then(response => response.json())
          .then(data => {
            this.addToCartButton.textContent = 'Added!';

            setTimeout(() => {
              this.addToCartButton.disabled = false;
              this.addToCartButton.textContent = this.addToCartButton.getAttribute('data-original-text') || 'Add to Cart';
            }, 2000);

            document.dispatchEvent(new CustomEvent('cart:refresh'));

            if (window.theme && window.theme.cart) {
              window.theme.cart.refresh();
            }
          })
          .catch(error => {
            console.error('Error adding to cart:', error);
            this.addToCartButton.disabled = false;
            this.addToCartButton.textContent = 'Error - Try Again';

            setTimeout(() => {
              this.addToCartButton.textContent = this.addToCartButton.getAttribute('data-original-text') || 'Add to Cart';
            }, 2000);
          });
        });

        this.addToCartButton.setAttribute('data-original-text', this.addToCartButton.textContent);
      }
    }

    customElements.define('product-feature-{{ ai_gen_id }}', ProductFeature{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product feature section",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Benefits"
    },
    {
      "type": "color",
      "id": "benefits_rail_bg_start",
      "label": "Benefits rail color (top)",
      "default": "#F0D0FF"
    },
    {
      "type": "color",
      "id": "benefits_rail_bg_end",
      "label": "Benefits rail color (bottom)",
      "default": "#B154FF"
    },
    {
      "type": "text",
      "id": "benefit_1_text",
      "label": "Benefit 1 text",
      "default": "5x better uptake"
    },
    {
      "type": "image_picker",
      "id": "benefit_1_image",
      "label": "Benefit 1 image"
    },
    {
      "type": "text",
      "id": "benefit_2_text",
      "label": "Benefit 2 text",
      "default": "Train harder, more often"
    },
    {
      "type": "image_picker",
      "id": "benefit_2_image",
      "label": "Benefit 2 image"
    },
    {
      "type": "text",
      "id": "benefit_3_text",
      "label": "Benefit 3 text",
      "default": "Rapid muscle repair + sustained energy"
    },
    {
      "type": "image_picker",
      "id": "benefit_3_image",
      "label": "Benefit 3 image"
    },
    {
      "type": "text",
      "id": "benefit_4_text",
      "label": "Benefit 4 text",
      "default": "Gain a metabolic advantage"
    },
    {
      "type": "image_picker",
      "id": "benefit_4_image",
      "label": "Benefit 4 image"
    }
  ],
  "presets": [
    {
      "name": "Product feature section"
    }
  ]
}
{% endschema %}
