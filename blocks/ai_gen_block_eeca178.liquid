<product-feature-{{ ai_gen_id }}
  class="ai-product-feature ai-product-feature-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-feature__container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank %}
      <div class="ai-product-feature__header-{{ ai_gen_id }}">
        <h2 class="section_heading">{{ block.settings.section_title }}</h2>
        <p class="section_subheading">{{ block.settings.section_subtitle }}</p>
      </div>
    {% endif %}

    {% if block.settings.product != blank %}
      {% assign product = block.settings.product %}
      {% assign selected_variant = product.selected_or_first_available_variant %}

      <div class="ai-product-feature__grid-{{ ai_gen_id }}">
        <div class="ai-product-feature__benefits-{{ ai_gen_id }}">
          {% assign use_pillar = block.settings.enable_benefits_pill %}
          <div class="ai-product-feature__benefits-pillar-{{ ai_gen_id }} {% if use_pillar %}ai-product-feature__benefits-pillar--gradient-{{ ai_gen_id }}{% endif %}">
            {% for i in (1..4) %}
              {% liquid
                assign benefit_text_key = 'benefit_' | append: i | append: '_text'
                assign benefit_icon_key = 'benefit_' | append: i | append: '_icon'
                assign benefit_color_key = 'benefit_' | append: i | append: '_color'
                assign benefit_color2_key = 'benefit_' | append: i | append: '_color_2'
                assign benefit_image_key = 'benefit_' | append: i | append: '_image'

                assign benefit_text = block.settings[benefit_text_key]
                assign benefit_icon = block.settings[benefit_icon_key]
                assign benefit_color = block.settings[benefit_color_key]
                assign benefit_color2 = block.settings[benefit_color2_key]
                assign benefit_image = block.settings[benefit_image_key]
              %}

              {% if benefit_text != blank %}
                {% capture bg_style %}
                  {% if benefit_color2 != blank %}
                    background-image: linear-gradient(180deg, {{ benefit_color }}, {{ benefit_color2 }});
                  {% else %}
                    background-color: {{ benefit_color }};
                  {% endif %}
                {% endcapture %}

                <div class="ai-product-feature__benefit-item-{{ ai_gen_id }}">
                  <div class="ai-product-feature__benefit-icon-{{ ai_gen_id }}" style="{{ bg_style | strip }}">
                    {% if benefit_image %}
                      <img
                        src="{{ benefit_image | image_url: width: 96 }}"
                        alt="{{ benefit_text | escape }}"
                        class="ai-product-feature__benefit-img-{{ ai_gen_id }}"
                        loading="lazy"
                      >
                    {% else %}
                      {{ benefit_icon }}
                    {% endif %}
                  </div>
                  <div class="ai-product-feature__benefit-text-{{ ai_gen_id }}">{{ benefit_text }}</div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <div class="ai-product-feature__media-{{ ai_gen_id }}">
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 1000 }}"
              alt="{{ product.featured_image.alt | escape }}"
              loading="lazy"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
              class="ai-product-feature__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-product-feature__image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <div class="ai-product-feature__details-{{ ai_gen_id }}">
          <h3 class="ai-product-feature__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>

          {% if product.description != blank %}
            <div class="ai-product-feature__product-description-{{ ai_gen_id }}">
              {{ product.description | strip_html | truncate: 200 }}
            </div>
          {% endif %}
          <hr>
          {% if product.metafields.custom.weight != blank %}
            <div class="ai-product-feature__weight-{{ ai_gen_id }}">
              <strong>Weight: </strong>{{ product.metafields.custom.weight }}
            </div>
          {% endif %}

          <div class="ai-product-feature__pricing-{{ ai_gen_id }}">
            <p>GET IT NOW FOR</p>
            <div class="ai-product-feature__pricing-prices-{{ ai_gen_id }}">
              <div class="ai-product-feature__price-{{ ai_gen_id }}">
                {{ selected_variant.price | money }}
              </div>

              {% if selected_variant.compare_at_price > selected_variant.price %}
                <div class="ai-product-feature__compare-price-{{ ai_gen_id }}">
                  {{ selected_variant.compare_at_price | money }}
                </div>

                {% assign discount_percentage = selected_variant.compare_at_price
                  | minus: selected_variant.price
                  | times: 100
                  | divided_by: selected_variant.compare_at_price
                %}
                <div class="ai-product-feature__discount-badge-{{ ai_gen_id }}">{{ discount_percentage }}% OFF</div>
              {% endif %}
            </div>
          </div>

          <div class="ai-product-feature__actions-{{ ai_gen_id }}">
            <div class="ai-product-feature__quantity-wrapper-{{ ai_gen_id }}">
              <span class="ai-product-feature__quantity-label-{{ ai_gen_id }}">Select BOX QTY</span>
              <div class="ai-product-feature__quantity-selector-{{ ai_gen_id }}">
                <button
                  type="button"
                  class="ai-product-feature__quantity-button-{{ ai_gen_id }}"
                  data-action="decrease"
                  aria-label="Decrease quantity"
                >
                  −
                </button>
                <input
                  type="number"
                  class="ai-product-feature__quantity-input-{{ ai_gen_id }}"
                  value="1"
                  min="1"
                  aria-label="Quantity"
                  readonly
                >
                <button
                  type="button"
                  class="ai-product-feature__quantity-button-{{ ai_gen_id }}"
                  data-action="increase"
                  aria-label="Increase quantity"
                >
                  +
                </button>
              </div>
            </div>

            <button
              type="button"
              class="ai-product-feature__add-to-cart-{{ ai_gen_id }}"
              data-variant-id="{{ selected_variant.id }}"
              {% unless selected_variant.available %}
                disabled
              {% endunless %}
            >
              {% if selected_variant.available %}
                {{ block.settings.button_text }}
              {% else %}
                Sold Out
              {% endif %}
            </button>
          </div>
        </div>
      </div>
    {% else %}
      <div class="ai-product-feature__empty-product-{{ ai_gen_id }}">Next, select a product to feature</div>
    {% endif %}
  </div>
</product-feature-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductFeature{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.quantityInput = this.querySelector('.ai-product-feature__quantity-input-{{ ai_gen_id }}');
        this.quantityButtons = this.querySelectorAll('.ai-product-feature__quantity-button-{{ ai_gen_id }}');
        this.addToCartButton = this.querySelector('.ai-product-feature__add-to-cart-{{ ai_gen_id }}');

        this.setupQuantityControls();
        this.setupAddToCart();
      }

      setupQuantityControls() {
        if (!this.quantityInput || !this.quantityButtons.length) return;

        this.quantityButtons.forEach(button => {
          button.addEventListener('click', () => {
            const action = button.getAttribute('data-action');
            let currentValue = parseInt(this.quantityInput.value) || 1;

            if (action === 'increase') {
              currentValue += 1;
            } else if (action === 'decrease' && currentValue > 1) {
              currentValue -= 1;
            }

            this.quantityInput.value = currentValue;
          });
        });
      }

      setupAddToCart() {
        if (!this.addToCartButton) return;

        this.addToCartButton.addEventListener('click', () => {
          const variantId = this.addToCartButton.getAttribute('data-variant-id');
          const quantity = parseInt(this.quantityInput.value) || 1;

          if (!variantId) return;

          this.addToCartButton.disabled = true;
          this.addToCartButton.textContent = 'Adding...';

          fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: variantId,
              quantity: quantity
            })
          })
          .then(response => response.json())
          .then(data => {
            this.addToCartButton.textContent = 'Added!';

            setTimeout(() => {
              this.addToCartButton.disabled = false;
              this.addToCartButton.textContent = this.addToCartButton.getAttribute('data-original-text') || 'Add to Cart';
            }, 2000);

            document.dispatchEvent(new CustomEvent('cart:refresh'));

            if (window.theme && window.theme.cart) {
              window.theme.cart.refresh();
            }
          })
          .catch(error => {
            console.error('Error adding to cart:', error);
            this.addToCartButton.disabled = false;
            this.addToCartButton.textContent = 'Error - Try Again';

            setTimeout(() => {
              this.addToCartButton.textContent = this.addToCartButton.getAttribute('data-original-text') || 'Add to Cart';
            }, 2000);
          });
        });

        this.addToCartButton.setAttribute('data-original-text', this.addToCartButton.textContent);
      }
    }

    customElements.define('product-feature-{{ ai_gen_id }}', ProductFeature{{ ai_gen_id }});
  })();
</script>

