{% doc %}
  @prompt
    Create a two-column blog article section layout.
    In the left column, show:
    
    
    The blog post’s featured image at the top.
    
    
    Below the image, display the published date and reading time (e.g., “October 10, 2025 — 4 Min Read”).
    
    
    Then show the blog title in bold, followed by the blog content with proper headings and spacing.
    
    
    In the right column, add a sidebar with two blocks:
    
    
    A “Hot Topics” list containing tags or categories like “Amino Energy”, “Cellular Health”, “Muscle Recovery”, “Daily Wellness”, etc.
    
    
    A “Recent Articles” section that lists the latest blog posts with clickable titles.
    
    
    Ensure the layout looks clean, modern, and readable — with balanced spacing, responsive design, and a dark background theme., add functional previous and next article buttons under description and add a search bar to search articles above hot topics
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-layout-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 60px;
    font-family: 'Gotham', sans-serif
  }

  .ai-blog-main-column-{{ ai_gen_id }} {
    min-width: 0;
  }

  .ai-blog-featured-image-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: 30px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-blog-featured-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-blog-featured-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: {{ block.settings.placeholder_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-blog-featured-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  .ai-blog-meta-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 25px;
    font-size: {{ block.settings.meta_font_size }}px;
    color: {{ block.settings.meta_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-blog-meta-divider-{{ ai_gen_id }} {
    width: 1px;
    height: 12px;
    background-color: {{ block.settings.meta_color }};
    opacity: 0.5;
  }

  .ai-blog-title-{{ ai_gen_id }} {
    font-size: 2.2rem;
    font-weight: 700;
    color: #211E24;
    margin: 0 0 30px;
    line-height: 1.1;
    font-family: 'gotham', sans-serif;  }

  .ai-blog-content-{{ ai_gen_id }} {
    color: #382D43;
    font-size: {{ block.settings.content_font_size }}px;
    line-height: 1.8;
  }

  .ai-blog-content-{{ ai_gen_id }} h2,
  .ai-blog-content-{{ ai_gen_id }} h3,
  .ai-blog-content-{{ ai_gen_id }} h4 {
    color: {{ block.settings.title_color }};
    margin-top: 40px;
    margin-bottom: 20px;
    font-weight: 600;
  }

  .ai-blog-content-{{ ai_gen_id }} h2 {
    font-size: 32px;
  }

  .ai-blog-content-{{ ai_gen_id }} h3 {
    font-size: 24px;
  }

  .ai-blog-content-{{ ai_gen_id }} h4 {
    font-size: 20px;
  }

  .ai-blog-content-{{ ai_gen_id }} p {
    margin-bottom: 20px;
        font-size: .9rem;
    font-weight: 300;
  }

  .ai-blog-content-{{ ai_gen_id }} ul,
  .ai-blog-content-{{ ai_gen_id }} ol {
    margin-bottom: 20px;
    padding-left: 25px;
  }

  .ai-blog-content-{{ ai_gen_id }} li {
    margin-bottom: 10px;
  }

  .ai-blog-navigation-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid {{ block.settings.divider_color }};
  }

  .ai-blog-nav-button-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    padding: 20px;
    background-color: {{ block.settings.nav_bg_color }};
    border-radius: {{ block.settings.nav_border_radius }}px;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid {{ block.settings.nav_border_color }};
  }

  .ai-blog-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_hover_bg }};
    transform: translateY(-2px);
  }

  .ai-blog-nav-button-{{ ai_gen_id }}.disabled {
    opacity: 0.3;
    pointer-events: none;
  }

  .ai-blog-nav-label-{{ ai_gen_id }} {
    font-size: 11px;
    color: {{ block.settings.meta_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-blog-nav-title-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.title_color }};
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-blog-nav-button-{{ ai_gen_id }}.next {
    text-align: right;
  }

  .ai-blog-nav-button-{{ ai_gen_id }}.next .ai-blog-nav-label-{{ ai_gen_id }} {
    justify-content: flex-end;
  }

  .ai-blog-nav-arrow-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    stroke: {{ block.settings.meta_color }};
  }

  .ai-blog-sidebar-{{ ai_gen_id }} {
    position: sticky;
    top: 100px;
    align-self: start;
  }

  .ai-blog-search-wrapper-{{ ai_gen_id }} {
    margin-bottom: 30px;
  }

  .ai-blog-search-form-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-blog-search-input-{{ ai_gen_id }} {
    width: 100%;
    padding: 14px 45px 14px 16px;
    background-color: {{ block.settings.search_bg_color }};
    border: 1px solid {{ block.settings.search_border_color }};
    border-radius: {{ block.settings.search_border_radius }}px;
    color: {{ block.settings.search_text_color }};
    font-size: 14px;
    transition: all 0.3s ease;
  }

  .ai-blog-search-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.search_placeholder_color }};
  }

  .ai-blog-search-input-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.search_focus_border }};
    background-color: {{ block.settings.search_focus_bg }};
  }

  .ai-blog-search-button-{{ ai_gen_id }} {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-blog-search-icon-{{ ai_gen_id }} {
    width: 18px;
    height: 18px;
    stroke: {{ block.settings.search_icon_color }};
  }

  .ai-blog-sidebar-block-{{ ai_gen_id }} {
    background-color: {{ block.settings.sidebar_bg_color }};
    padding: 30px;
    margin-bottom: 30px;
    border-radius: {{ block.settings.sidebar_border_radius }}px;
  }

  .ai-blog-sidebar-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.sidebar_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.sidebar_title_color }};
    margin: 0 0 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-blog-tags-list-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ai-blog-tag-{{ ai_gen_id }} {
    display: inline-block;
    padding: 8px 16px;
    background-color: {{ block.settings.tag_bg_color }};
    color: {{ block.settings.tag_text_color }};
    font-size: {{ block.settings.tag_font_size }}px;
    text-decoration: none;
    border-radius: {{ block.settings.tag_border_radius }}px;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 500;
  }

  .ai-blog-tag-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.tag_hover_bg }};
    color: {{ block.settings.tag_hover_text }};
    transform: translateY(-2px);
  }

  .ai-blog-recent-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-blog-recent-item-{{ ai_gen_id }} {
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-blog-recent-item-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .ai-blog-recent-link-{{ ai_gen_id }} {
    color: {{ block.settings.recent_link_color }};
    text-decoration: none;
    font-size: {{ block.settings.recent_font_size }}px;
    font-weight: 500;
    line-height: 1.4;
    display: block;
    transition: color 0.3s ease;
  }

  .ai-blog-recent-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.recent_link_hover }};
  }

  .ai-blog-recent-date-{{ ai_gen_id }} {
    font-size: 11px;
    color: {{ block.settings.meta_color }};
    margin-top: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  @media screen and (max-width: 990px) {
    .ai-blog-layout-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-blog-sidebar-{{ ai_gen_id }} {
      position: static;
    }

    .ai-blog-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.7 }}px;
    }

    .ai-blog-content-{{ ai_gen_id }} h2 {
      font-size: 24px;
    }

    .ai-blog-content-{{ ai_gen_id }} h3 {
      font-size: 20px;
    }

    .ai-blog-navigation-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .ai-blog-nav-button-{{ ai_gen_id }}.next {
      text-align: left;
    }

    .ai-blog-nav-button-{{ ai_gen_id }}.next .ai-blog-nav-label-{{ ai_gen_id }} {
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-blog-layout-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 15px;
    }

    .ai-blog-layout-container-{{ ai_gen_id }} {
      gap: 30px;
    }

    .ai-blog-sidebar-block-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-blog-navigation-{{ ai_gen_id }} {
      margin-top: 40px;
      padding-top: 30px;
    }
  }
{% endstyle %}

<div class="ai-blog-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-layout-container-{{ ai_gen_id }}">
    <div class="ai-blog-main-column-{{ ai_gen_id }}">
      <div class="ai-blog-featured-image-{{ ai_gen_id }}">
        {% if article.image %}
          <img
            src="{{ article.image | image_url: width: 1200 }}"
            alt="{{ article.image.alt | escape }}"
            loading="lazy"
            width="{{ article.image.width }}"
            height="{{ article.image.height }}"
          >
        {% else %}
          <div class="ai-blog-featured-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-blog-meta-{{ ai_gen_id }}">
        <span class="ai-blog-meta-date-{{ ai_gen_id }}">
          {{ article.published_at | date: '%B %d, %Y' }}
        </span>
        <span class="ai-blog-meta-divider-{{ ai_gen_id }}"></span>
        <span class="ai-blog-meta-reading-{{ ai_gen_id }}">
          {% assign words = article.content | strip_html | split: ' ' | size %}
          {% assign reading_time = words | divided_by: 200 %}
          {% if reading_time == 0 %}
            {% assign reading_time = 1 %}
          {% endif %}
          {{ reading_time }} Min Read
        </span>
      </div>

      <h1 class="ai-blog-title-{{ ai_gen_id }}">{{ article.title }}</h1>

      <div class="ai-blog-content-{{ ai_gen_id }}">
        {{ article.content }}
      </div>

      {% if block.settings.show_navigation %}
        <nav class="ai-blog-navigation-{{ ai_gen_id }}">
          {% if blog.previous_article %}
            <a href="{{ blog.previous_article.url }}" class="ai-blog-nav-button-{{ ai_gen_id }} previous">
              <span class="ai-blog-nav-label-{{ ai_gen_id }}">
                <svg
                  class="ai-blog-nav-arrow-{{ ai_gen_id }}"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
                {{ block.settings.previous_label }}
              </span>
              <span class="ai-blog-nav-title-{{ ai_gen_id }}">{{ blog.previous_article.title }}</span>
            </a>
          {% else %}
            <div class="ai-blog-nav-button-{{ ai_gen_id }} previous disabled">
              <span class="ai-blog-nav-label-{{ ai_gen_id }}">
                <svg
                  class="ai-blog-nav-arrow-{{ ai_gen_id }}"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
                {{ block.settings.previous_label }}
              </span>
              <span class="ai-blog-nav-title-{{ ai_gen_id }}">No previous article</span>
            </div>
          {% endif %}

          {% if blog.next_article %}
            <a href="{{ blog.next_article.url }}" class="ai-blog-nav-button-{{ ai_gen_id }} next">
              <span class="ai-blog-nav-label-{{ ai_gen_id }}">
                {{ block.settings.next_label }}
                <svg
                  class="ai-blog-nav-arrow-{{ ai_gen_id }}"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </span>
              <span class="ai-blog-nav-title-{{ ai_gen_id }}">{{ blog.next_article.title }}</span>
            </a>
          {% else %}
            <div class="ai-blog-nav-button-{{ ai_gen_id }} next disabled">
              <span class="ai-blog-nav-label-{{ ai_gen_id }}">
                {{ block.settings.next_label }}
                <svg
                  class="ai-blog-nav-arrow-{{ ai_gen_id }}"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </span>
              <span class="ai-blog-nav-title-{{ ai_gen_id }}">No next article</span>
            </div>
          {% endif %}
        </nav>
      {% endif %}
    </div>

    <aside class="ai-blog-sidebar-{{ ai_gen_id }}">
      {% if block.settings.show_search %}
        <div class="ai-blog-search-wrapper-{{ ai_gen_id }}">
          <form action="{{ blog.url }}/search" method="get" class="ai-blog-search-form-{{ ai_gen_id }}">
            <input
              type="search"
              name="q"
              class="ai-blog-search-input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.search_placeholder }}"
              aria-label="Search articles"
            >
            <button type="submit" class="ai-blog-search-button-{{ ai_gen_id }}" aria-label="Submit search">
              <svg
                class="ai-blog-search-icon-{{ ai_gen_id }}"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
              </svg>
            </button>
          </form>
        </div>
      {% endif %}

      {% if block.settings.show_hot_topics %}
        <div class="ai-blog-sidebar-block-{{ ai_gen_id }}">
          <h3 class="ai-blog-sidebar-title-{{ ai_gen_id }}">{{ block.settings.hot_topics_title }}</h3>
          <div class="ai-blog-tags-list-{{ ai_gen_id }}">
            {% if block.settings.tag_1 != blank %}
              <a href="{{ block.settings.tag_1_link }}" class="ai-blog-tag-{{ ai_gen_id }}">
                {{ block.settings.tag_1 }}
              </a>
            {% endif %}
            {% if block.settings.tag_2 != blank %}
              <a href="{{ block.settings.tag_2_link }}" class="ai-blog-tag-{{ ai_gen_id }}">
                {{ block.settings.tag_2 }}
              </a>
            {% endif %}
            {% if block.settings.tag_3 != blank %}
              <a href="{{ block.settings.tag_3_link }}" class="ai-blog-tag-{{ ai_gen_id }}">
                {{ block.settings.tag_3 }}
              </a>
            {% endif %}
            {% if block.settings.tag_4 != blank %}
              <a href="{{ block.settings.tag_4_link }}" class="ai-blog-tag-{{ ai_gen_id }}">
                {{ block.settings.tag_4 }}
              </a>
            {% endif %}
            {% if block.settings.tag_5 != blank %}
              <a href="{{ block.settings.tag_5_link }}" class="ai-blog-tag-{{ ai_gen_id }}">
                {{ block.settings.tag_5 }}
              </a>
            {% endif %}
            {% if block.settings.tag_6 != blank %}
              <a href="{{ block.settings.tag_6_link }}" class="ai-blog-tag-{{ ai_gen_id }}">
                {{ block.settings.tag_6 }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_recent_articles %}
        <div class="ai-blog-sidebar-block-{{ ai_gen_id }}">
          <h3 class="ai-blog-sidebar-title-{{ ai_gen_id }}">{{ block.settings.recent_articles_title }}</h3>
          <ul class="ai-blog-recent-list-{{ ai_gen_id }}">
            {% if block.settings.recent_blog != blank %}
              {% for article in block.settings.recent_blog.articles limit: block.settings.recent_articles_count %}
                <li class="ai-blog-recent-item-{{ ai_gen_id }}">
                  <a href="{{ article.url }}" class="ai-blog-recent-link-{{ ai_gen_id }}">
                    {{ article.title }}
                  </a>
                  <div class="ai-blog-recent-date-{{ ai_gen_id }}">
                    {{ article.published_at | date: '%b %d, %Y' }}
                  </div>
                </li>
              {% endfor %}
            {% else %}
              {% for i in (1..3) %}
                <li class="ai-blog-recent-item-{{ ai_gen_id }}">
                  <a href="#" class="ai-blog-recent-link-{{ ai_gen_id }}"> Sample Article Title {{ i }} </a>
                  <div class="ai-blog-recent-date-{{ ai_gen_id }}">Oct {{ i | times: 5 }}, 2025</div>
                </li>
              {% endfor %}
            {% endif %}
          </ul>
        </div>
      {% endif %}
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "Two column blog layout",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section padding",
      "default": 60
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Featured image"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "color",
      "id": "placeholder_bg",
      "label": "Placeholder background",
      "default": "#2a2a2a"
    },
    {
      "type": "header",
      "content": "Article meta"
    },
    {
      "type": "range",
      "id": "meta_font_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 11
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Text color",
      "default": "#999999"
    },
    {
      "type": "header",
      "content": "Article title"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 48
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Article content"
    },
    {
      "type": "range",
      "id": "content_font_size",
      "min": 14,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Text color",
      "default": "#382D43"
    },
    {
      "type": "header",
      "content": "Article navigation"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show previous and next buttons",
      "default": true
    },
    {
      "type": "text",
      "id": "previous_label",
      "label": "Previous label",
      "default": "Previous"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next label",
      "default": "Next"
    },
    {
      "type": "color",
      "id": "nav_bg_color",
      "label": "Background color",
      "default": "#2a2a2a"
    },
    {
      "type": "color",
      "id": "nav_hover_bg",
      "label": "Hover background",
      "default": "#3a3a3a"
    },
    {
      "type": "color",
      "id": "nav_border_color",
      "label": "Border color",
      "default": "#3a3a3a"
    },
    {
      "type": "range",
      "id": "nav_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search bar",
      "default": true
    },
