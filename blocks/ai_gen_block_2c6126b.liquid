            .ai-contact-split-{{ ai_gen_id }} {
              width: 100%;
              padding: 100px 20px;
              background-color: {{ block.settings.section_background }};
            }

            .ai-contact-split-container-{{ ai_gen_id }} {
              max-width: 1200px;
              margin: 0 auto;
              display: grid;
              grid-template-columns: 1fr 1fr;
              align-items: stretch;
              border: solid 1px #E1E1E1;
              border-radius: 15px;
              overflow: hidden;
            }

            .ai-contact-split-left-{{ ai_gen_id }} {
              background-color: {{ block.settings.form_background }};
              padding: {{ block.settings.form_padding }}px;
              border-radius: 60px;
            }

            .ai-contact-split-heading-{{ ai_gen_id }} {
              font-size: 2.1rem;
              color: #000000;
              margin: 0 0 6px;
              font-family: 'Gotham', sans-serif;
              font-weight: 600;  }

            .ai-contact-split-subheading-{{ ai_gen_id }} {
          font-size: 14px;
              color: #382D43;
              margin: 0 0 30px;
              font-family: 'Gotham', sans-serif;
              font-weight: 300;  }

            .ai-contact-split-form-{{ ai_gen_id }} {
              display: flex;
              flex-direction: column;
              gap: 20px;
            }

            .ai-contact-split-field-{{ ai_gen_id }} {
              display: flex;
              flex-direction: column;
              gap: 8px;
            }

            .ai-contact-split-label-{{ ai_gen_id }} {
              font-size: 14px;
              font-weight: 600;
              color: {{ block.settings.text_color }};
            }

            .ai-contact-split-input-{{ ai_gen_id }},
            .ai-contact-split-textarea-{{ ai_gen_id }} {
              width: 100%;
              padding: 12px 16px;
              border: 1px solid {{ block.settings.input_border_color }};
              border-radius: {{ block.settings.input_border_radius }}px;
              font-size: 14px;
              color: {{ block.settings.text_color }};
              background-color: {{ block.settings.input_background }};
              transition: border-color 0.3s ease;
            }

            .ai-contact-split-input-{{ ai_gen_id }}:focus,
            .ai-contact-split-textarea-{{ ai_gen_id }}:focus {
              outline: none;
              border-color: {{ block.settings.input_focus_border }};
            }

            .ai-contact-split-textarea-{{ ai_gen_id }} {
              min-height: 120px;
              resize: vertical;
            }

            .ai-contact-split-submit-{{ ai_gen_id }} {
              background-color: #8c31ae;
              color: #fff;
              border: none;
              border-radius: 200px;
              cursor: pointer;
              transition: all 0.3s ease;
              text-transform: uppercase;
                  font-family: 'Gotham', sans-serif;
            font-weight: 400;
            font-size: 14px;
            padding: 20px 20px;
            }

            .ai-contact-split-submit-{{ ai_gen_id }}:hover {
              scale: 1.02;
              transition: all 0.3s ease;
            }

            .ai-contact-split-message-{{ ai_gen_id }} {
              padding: 12px 16px;
              border-radius: {{ block.settings.input_border_radius }}px;
              font-size: 14px;
              margin-top: 16px;
            }

            .ai-contact-split-success-{{ ai_gen_id }} {
              background-color: #d4edda;
              color: #155724;
              border: 1px solid #c3e6cb;
            }

            .ai-contact-split-error-{{ ai_gen_id }} {
              background-color: #f8d7da;
              color: #721c24;
              border: 1px solid #f5c6cb;
            }

            .ai-contact-split-right-{{ ai_gen_id }} {
              position: relative;
              overflow: hidden;
              min-height: 500px;
            }

            .ai-contact-split-bg-image-{{ ai_gen_id }} {
              position: absolute;
              top: 0;
              left: 0;
              width: 100%;
              height: 100%;
              object-fit: cover;
            }

            .ai-contact-split-bg-placeholder-{{ ai_gen_id }} {
              position: absolute;
              top: 0;
              left: 0;
              width: 100%;
              height: 100%;
              background-color: #f4f4f4;
            }

            .ai-contact-split-bg-placeholder-{{ ai_gen_id }} svg {
              width: 100%;
              height: 100%;
              object-fit: cover;
            }

            .ai-contact-split-overlay-{{ ai_gen_id }} {
              position: absolute;
              top: 0;
              left: 0;
              width: 100%;
              height: 100%;
            }

            .ai-contact-split-card-{{ ai_gen_id }} {
      position: relative;
          z-index: 2;
          background-color: #ffffff;
          padding: 60px;
          margin: 40px;
          height: calc(100% - 80px);
          border-radius: 12px;
          justify-content: center;
          align-items: start;
          display: flex
      ;
          flex-direction: column;      }

            .ai-contact-split-card-heading-{{ ai_gen_id }} {
            font-size: 2.1rem;
            color: #000000;
            margin: 0 0 6px;
            font-family: 'Gotham', sans-serif;
            font-weight: 600;    }

            .ai-contact-split-card-text-{{ ai_gen_id }} {
            font-size: 14px;
            color: #382D43;
            margin: 0 0 55px;
            font-family: 'Gotham', sans-serif;
            font-weight: 300;
            }

            .ai-contact-split-info-blocks-{{ ai_gen_id }} {
              display: flex;
              flex-direction: column;
              gap: 55px;
            }

            .ai-contact-split-info-block-{{ ai_gen_id }} {
              display: flex;
              align-items: center;
              gap: 16px;
            }

            .ai-contact-split-icon-{{ ai_gen_id }} {
              flex-shrink: 0;
              width: 70px;
              height: auto;
              display: flex;
              align-items: center;
              justify-content: center;
              background-color: {{ block.settings.icon_background }};
              border-radius: 50%;
              color: {{ block.settings.icon_color }};
            }

            .ai-contact-split-icon-{{ ai_gen_id }} svg {
              width: 20px;
              height: 20px;
              stroke: currentColor;
              fill: none;
            }

            .ai-contact-split-info-content-{{ ai_gen_id }} {
              flex-grow: 1;
            }

            .ai-contact-split-info-label-{{ ai_gen_id }} {
              font-size: 14px;
              font-weight: 600;
              color: {{ block.settings.card_text_color }};
              margin: 0 0 4px;
              text-transform: uppercase;
            }

            .ai-contact-split-info-value-{{ ai_gen_id }} {
        font-size: 14px;
            color: #382D43;
            opacity: .7;
            margin: 0;
            word-break: break-word;
            font-weight: 300;    }

            .ai-contact-split-info-link-{{ ai_gen_id }} {
              display: inline-block;
              margin-top: 8px;
              font-size: 14px;
              color: {{ block.settings.link_color }};
              text-decoration: underline;
            }

            .ai-contact-split-info-link-{{ ai_gen_id }}:hover {
              color: {{ block.settings.link_hover_color }};
            }

            @media screen and (max-width: 768px) {
              .ai-contact-split-container-{{ ai_gen_id }} {
                grid-template-columns: 1fr;
                gap: 30px;
              }

              .ai-contact-split-left-{{ ai_gen_id }} {
                padding: {{ block.settings.form_padding | times: 0.7 }}px;
              }

              .ai-contact-split-card-{{ ai_gen_id }} {
                margin: 20px;
                padding: {{ block.settings.card_padding | times: 0.7 }}px;
              }

              .ai-contact-split-heading-{{ ai_gen_id }} {
                font-size: {{ block.settings.heading_size | times: 0.8 }}px;
              }

              .ai-contact-split-card-heading-{{ ai_gen_id }} {
                font-size: {{ block.settings.card_heading_size | times: 0.8 }}px;
              }
            }
{% endstyle %}

<div class="ai-contact-split-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-split-container-{{ ai_gen_id }}">
    <div class="ai-contact-split-left-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-contact-split-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="ai-contact-split-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}

      {% form 'contact' %}
        <div class="ai-contact-split-form-{{ ai_gen_id }}">
          <div class="ai-contact-split-field-{{ ai_gen_id }}">
            <label class="ai-contact-split-label-{{ ai_gen_id }}" for="contact-name-{{ ai_gen_id }}">
              Name <span style="color: #d82c0d;">*</span>
            </label>
            <input
              type="text"
              id="contact-name-{{ ai_gen_id }}"
              name="contact[name]"
              class="ai-contact-split-input-{{ ai_gen_id }}"
              required
              aria-required="true"
            >
          </div>

          <div class="ai-contact-split-field-{{ ai_gen_id }}">
            <label class="ai-contact-split-label-{{ ai_gen_id }}" for="contact-mobile-{{ ai_gen_id }}">
              Mobile <span style="color: #d82c0d;">*</span>
            </label>
            <input
              type="tel"
              id="contact-mobile-{{ ai_gen_id }}"
              name="contact[phone]"
              class="ai-contact-split-input-{{ ai_gen_id }}"
              required
              aria-required="true"
            >
          </div>

          <div class="ai-contact-split-field-{{ ai_gen_id }}">
            <label class="ai-contact-split-label-{{ ai_gen_id }}" for="contact-email-{{ ai_gen_id }}">
              Email <span style="color: #d82c0d;">*</span>
            </label>
            <input
              type="email"
              id="contact-email-{{ ai_gen_id }}"
              name="contact[email]"
              class="ai-contact-split-input-{{ ai_gen_id }}"
              required
              aria-required="true"
              autocomplete="email"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="contact-error-{{ ai_gen_id }}"
              {% endif %}
              {% if form.posted_successfully? %}
                aria-describedby="contact-success-{{ ai_gen_id }}"
              {% endif %}
            >
          </div>

          <div class="ai-contact-split-field-{{ ai_gen_id }}">
            <label class="ai-contact-split-label-{{ ai_gen_id }}" for="contact-message-{{ ai_gen_id }}">
              Message / Query <span style="color: #d82c0d;">*</span>
            </label>
            <textarea
              id="contact-message-{{ ai_gen_id }}"
              name="contact[body]"
              class="ai-contact-split-textarea-{{ ai_gen_id }}"
              required
              aria-required="true"
            ></textarea>
          </div>

          <button type="submit" class="ai-contact-split-submit-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </button>

          {% if form.posted_successfully? %}
            <div
              id="contact-success-{{ ai_gen_id }}"
              class="ai-contact-split-message-{{ ai_gen_id }} ai-contact-split-success-{{ ai_gen_id }}"
            >
              {{ block.settings.success_message }}
            </div>
          {% endif %}

          {% if form.errors %}
            <div
              id="contact-error-{{ ai_gen_id }}"
              class="ai-contact-split-message-{{ ai_gen_id }} ai-contact-split-error-{{ ai_gen_id }}"
            >
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
        </div>
      {% endform %}
    </div>

    <div class="ai-contact-split-right-{{ ai_gen_id }}">
      {% if block.settings.background_image %}
        <img
          src="{{ block.settings.background_image | image_url: width: 1000 }}"
          alt="{{ block.settings.background_image.alt | escape }}"
          class="ai-contact-split-bg-image-{{ ai_gen_id }}"
          loading="lazy"
        >
      {% else %}
        <div class="ai-contact-split-bg-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}

      <div class="ai-contact-split-overlay-{{ ai_gen_id }}"></div>

      <div class="ai-contact-split-card-{{ ai_gen_id }}">
        {% if block.settings.card_heading != blank %}
          <h3 class="ai-contact-split-card-heading-{{ ai_gen_id }}">{{ block.settings.card_heading }}</h3>
        {% endif %}

        {% if block.settings.card_text != blank %}
          <p class="ai-contact-split-card-text-{{ ai_gen_id }}">{{ block.settings.card_text }}</p>
        {% endif %}

        <div class="ai-contact-split-info-blocks-{{ ai_gen_id }}">
          <div class="ai-contact-split-info-block-{{ ai_gen_id }}">
            <div class="ai-contact-split-icon-{{ ai_gen_id }}">
              <img src="https://cdn.shopify.com/s/files/1/0961/3190/7863/files/Group_298.png?v=1761635130">
            </div>
            <div class="ai-contact-split-info-content-{{ ai_gen_id }}">
              <p class="ai-contact-split-info-label-{{ ai_gen_id }}">Phone</p>
              <p class="ai-contact-split-info-value-{{ ai_gen_id }}">{{ block.settings.phone_number }}</p>
            </div>
          </div>

          <div class="ai-contact-split-info-block-{{ ai_gen_id }}">
            <div class="ai-contact-split-icon-{{ ai_gen_id }}">
              <img src="https://cdn.shopify.com/s/files/1/0961/3190/7863/files/Group_299.png?v=1761635131">
            </div>
            <div class="ai-contact-split-info-content-{{ ai_gen_id }}">
              <p class="ai-contact-split-info-label-{{ ai_gen_id }}">Email</p>
              <p class="ai-contact-split-info-value-{{ ai_gen_id }}">{{ block.settings.email_address }}</p>
            </div>
          </div>

          <div class="ai-contact-split-info-block-{{ ai_gen_id }}">
            <div class="ai-contact-split-icon-{{ ai_gen_id }}">
              <img src="https://cdn.shopify.com/s/files/1/0961/3190/7863/files/Group_300.png?v=1761635129">
            </div>
            <div class="ai-contact-split-info-content-{{ ai_gen_id }}">
              <p class="ai-contact-split-info-label-{{ ai_gen_id }}">Address</p>
              <p class="ai-contact-split-info-value-{{ ai_gen_id }}">{{ block.settings.office_address }}</p>
              {% if block.settings.map_link != blank %}
                <a
                  href="{{ block.settings.map_link }}"
                  class="ai-contact-split-info-link-{{ ai_gen_id }}"
                  target="_blank"
                  rel="noopener"
                >
                  View on Google Map
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="section">
  <div class="social-media-links">
    <p>Follow us on</p>
    <h3>Stay connected! Follow us on social media for updates, news, and more.</h3>
    <div class="social_media_links_container">
      <a href="{{block.settings.linkedin_link}}">
        <img src="{{block.settings.linkeind_image |  img_url: 'master'}}">
      </a>

      <a href="{{block.settings.facebook_link}}">
        <img src="{{block.settings.facebook_image |  img_url: 'master'}}">
      </a>
      <a href="{{block.settings.twitter_link}}">
        <img src="{{block.settings.twitter_image |  img_url: 'master'}}">
      </a>

      <a href="{{block.settings.youtube_link}}">
        <img src="{{block.settings.youtube_image |  img_url: 'master'}}">
      </a>
    </div>
  </div>
</div>

