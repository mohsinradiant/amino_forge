{% doc %}
  @prompt
    Create a clean, centered product highlight section similar to a hero layout.
    
    At the top, add an image picker setting for the brand logo.
    
    Below it, include a small heading setting (text).
    
    Then add a description text area that supports rich text formatting.
    
    Add a button with editable text and a product selector so the user can choose a product to link to. When the button is clicked, it should automatically add the selected product to the cart.
    
    Finally, add a main image picker setting for a large product image displayed at the bottom (centered).
    
    Layout should be vertically stacked and centered on desktop and mobile, similar to a modern landing page section.
    
    Example visual order:
    
    Logo Image (small, top)
    
    Small Heading (uppercase optional)
    
    Description (rich text paragraph)
    
    Button (Add to Cart for linked product)
    
    Large Product Image (bottom, full width or max 600px wide, centered)
    
    Ensure spacing and alignment feel balanced with enough white space.
    Button should have customizable background and text color settings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-highlight-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    text-align: center;
  }

  .ai-product-highlight-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.spacing }}px;
  }

  .ai-product-highlight-logo-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.logo_width }}px;
  }

  .ai-product-highlight-logo-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-product-highlight-logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.logo_width }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .ai-product-highlight-logo-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
    max-height: 80px;
  }

  .ai-product-highlight-heading-{{ ai_gen_id }} {
    color: #9e3eb2;
    margin: 0;
    font-size: 0.9rem;
    font-family: 'Gotham', sans-serif;
    font-weight: 500;
  }

  .ai-product-highlight-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    max-width: {{ block.settings.description_max_width }}px;
  }

  .ai-product-highlight-description-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-product-highlight-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    {% if block.settings.button_uppercase %}
      text-transform: uppercase;
    {% endif %}
    letter-spacing: 1px;
  }

  .ai-product-highlight-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-product-highlight-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-product-highlight-image-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
  }

  .ai-product-highlight-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-highlight-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-product-highlight-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-product-highlight-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 16px;
    }

    .ai-product-highlight-container-{{ ai_gen_id }} {
      gap: {{ block.settings.spacing | times: 0.8 }}px;
    }

    .ai-product-highlight-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-product-highlight-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-product-highlight-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.9 }}px {{ block.settings.button_padding_horizontal | times: 0.9 }}px;
    }
  }
{% endstyle %}

<product-highlight-{{ ai_gen_id }}
  class="ai-product-highlight-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-highlight-container-{{ ai_gen_id }}">
    {% if block.settings.logo %}
      <div class="ai-product-highlight-logo-{{ ai_gen_id }}">
        <img
          src="{{ block.settings.logo | image_url: width: 400 }}"
          alt="{{ block.settings.logo.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.logo.width }}"
          height="{{ block.settings.logo.height }}"
        >
      </div>
    {% else %}
      <div class="ai-product-highlight-logo-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h2 class="ai-product-highlight-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="ai-product-highlight-description-{{ ai_gen_id }}">
        {{ block.settings.description }}
      </div>
    {% endif %}

    {% if block.settings.product %}
      <button
        class="ai-product-highlight-button-{{ ai_gen_id }}"
        data-product-id="{{ block.settings.product.selected_or_first_available_variant.id }}"
        aria-label="Add {{ block.settings.product.title }} to cart"
      >
        {{ block.settings.button_text }}
      </button>
    {% else %}
      <button
        class="ai-product-highlight-button-{{ ai_gen_id }}"
        disabled
      >
        {{ block.settings.button_text }}
      </button>
    {% endif %}

    {% if block.settings.product_image %}
      <div class="ai-product-highlight-image-{{ ai_gen_id }}">
        <img
          src="{{ block.settings.product_image | image_url: width: 1200 }}"
          alt="{{ block.settings.product_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.product_image.width }}"
          height="{{ block.settings.product_image.height }}"
        >
      </div>
    {% else %}
      <div class="ai-product-highlight-image-placeholder-{{ ai_gen_id }}">
        {{ 'product-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>
</product-highlight-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductHighlight{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.button = this.querySelector('.ai-product-highlight-button-{{ ai_gen_id }}');
        if (this.button && !this.button.disabled) {
          this.button.addEventListener('click', this.handleAddToCart.bind(this));
        }
      }

      async handleAddToCart(event) {
        event.preventDefault();
        const button = event.currentTarget;
        const variantId = button.dataset.productId;

        if (!variantId) return;

        button.disabled = true;
        const originalText = button.textContent;
        button.textContent = 'Adding...';

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              items: [{
                id: variantId,
                quantity: 1
              }]
            })
          });

          if (!response.ok) {
            throw new Error('Failed to add to cart');
          }

          button.textContent = 'Added!';

          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);

          document.dispatchEvent(new CustomEvent('cart:refresh'));

          const cartDrawer = document.querySelector('cart-drawer');
          if (cartDrawer) {
            cartDrawer.open();
          }

        } catch (error) {
          console.error('Error adding to cart:', error);
          button.textContent = 'Error - Try again';
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);
        }
      }
    }

    customElements.define('product-highlight-{{ ai_gen_id }}', ProductHighlight{{ ai_gen_id }});
  })();
</script>

