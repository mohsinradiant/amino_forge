<div class="product-rating" data-product-handle="{{ product.handle }}">
  <div class="stars"></div>
  <span class="rating-value">0.0</span>
  <span class="rating-count">(0)</span>
</div>
<style>
  .product-rating {
    display: flex;
    justify-content: center;
    align-items: center;
    width: fit-content;
  }
  .product-rating .stars {
    display: flex;
    gap: 10px;
  }
</style>
{% schema %}
{
  "name": "Ratings",
  "presets": [
    {
      "name": "Ratings"
    }
  ]
}
{% endschema %}
